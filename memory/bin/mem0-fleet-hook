def now_mdt() -> str:
    return datetime.now(ZoneInfo("America/Denver")).isoformat(timespec="seconds")


def sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8", errors="replace")).hexdigest()


def safe_component(value: str, fallback: str = "unknown") -> str:
    return re.sub(r"[^A-Za-z0-9._-]+", "_", value or "")[:160] or fallback


def ensure_private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    try:
        path.chmod(0o700)
    except OSError:
        pass


def state_root(machine: str | None = None, harness: str | None = None) -> Path:
    """Return the private state lane selected by a request's frozen routing."""
    return STATE / safe_component(machine or MACHINE) / safe_component(harness or HARNESS)


def session_lock_path(session: str, machine: str | None = None, harness: str | None = None) -> Path:
    return state_root(machine, harness) / "locks" / f"{safe_component(session)}.lock"


@contextmanager
def file_lock(path: Path, nonblocking: bool = False):
    """Hold a stable flock inode; callers never remove this path."""
    ensure_private_dir(path.parent)
    handle = open(path, "a+", encoding="utf-8")
    flags = fcntl.LOCK_EX | (fcntl.LOCK_NB if nonblocking else 0)
    try:
        fcntl.flock(handle.fileno(), flags)
    except Exception:
        handle.close()
        raise
    try:
        yield handle
    finally:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        finally:
            handle.close()


def atomic_json(path: Path, payload: dict[str, Any]) -> None:
    ensure_private_dir(path.parent)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def _sync_file(fd: int) -> None:
    os.fsync(fd)
    if sys.platform == "darwin":
        # macOS fsync alone does not flush drive write caches. Fail closed if
        # the filesystem/device cannot honor the stronger persistence barrier.
        fcntl.fcntl(fd, fcntl.F_FULLFSYNC)


def _sync_directory(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _durable_directory(path: Path) -> None:
    missing = []
    current = path
    while not current.exists():
        missing.append(current)
        current = current.parent
    for directory in reversed(missing):
        directory.mkdir(mode=0o700, exist_ok=True)
        _sync_directory(directory.parent)
    # A prior interrupted mkdir may be visible but not yet persisted. Sync
    # ancestry again before the final file barrier flushes the device cache.
    current = path
    while current != current.parent:
        _sync_directory(current.parent)
        if current == BASE:
            break
        current = current.parent


def durable_existing(path: Path) -> None:
    """Persist unchanged legacy/current bytes and name before trusting them."""
    with path.open("rb") as handle:
        _durable_directory(path.parent)
        _sync_file(handle.fileno())
        _sync_directory(path.parent)
        _sync_file(handle.fileno())


def durable_json(path: Path, payload: dict[str, Any]) -> None:
    _durable_directory(path.parent)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            _sync_file(handle.fileno())
            os.replace(tmp, path)
            _sync_directory(path.parent)
            # Flush after the directory barrier as well as before rename.
            _sync_file(handle.fileno())
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def durable_unlink(path: Path, barrier: Path) -> None:
    """Remove an anchor only after its replacement has been persisted."""
    durable_existing(barrier)
    path.unlink(missing_ok=True)
    _sync_directory(path.parent)
    # The surviving file provides a device flush after the name removal.
    with barrier.open("rb") as handle:
        _sync_file(handle.fileno())


def log_event(event: str, status: str, **fields: Any) -> None:
    allowed = {"session", "turn", "generation", "count", "reason", "event_name", "digest", "project", "elapsed_ms", "mode", "output_bytes", "output_sha256"}
    row: dict[str, Any] = {"at": now_mdt(), "event": event, "status": status, "machine": MACHINE, "harness": HARNESS}
    for key, value in fields.items():
        if key in allowed and value is not None:
            row[key] = value
    try:
        ensure_private_dir(LOG.parent)
        fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(row, sort_keys=True, ensure_ascii=True) + "\n")
    except Exception:
        pass


def load_payload() -> dict[str, Any]:
    try:
        value = json.load(sys.stdin)
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def pick(payload: dict[str, Any], *keys: str, default: Any = "") -> Any:
    for key in keys:
        value = payload.get(key)
        if value not in (None, ""):
            return value
    return default


def is_subagent(payload: dict[str, Any]) -> bool:
    return bool(pick(payload, "agent_id", "agentId", "agent_type", "agentType", "subagent_type", "subagentType"))


def _grok_subagent_metadata(value: Any) -> bool:
    if not isinstance(value, dict):
        return False
    return bool(pick(value, "subagentType", "subagent_type"))


def is_grok_subagent(payload: dict[str, Any]) -> bool:
    """Recognize only Grok's explicit subagent fields, never agentType."""
    if _grok_subagent_metadata(payload):
        return True
    if _grok_subagent_metadata(payload.get("metadata")):
        return True
    for key in ("hookSpecificOutput", "hook_specific_output"):
        nested = payload.get(key)
        if isinstance(nested, dict) and (
            _grok_subagent_metadata(nested)
            or _grok_subagent_metadata(nested.get("metadata"))
        ):
            return True
    return False


def sensitive_reason(text: str) -> str | None:
    for pattern, reason in (
        (SECRET_VALUE_RE, "secret-label"), (BEARER_RE, "bearer"), (EMAIL_RE, "email"),
        (PHONE_RE, "phone"), (SSN_RE, "ssn"), (STREET_RE, "street-address"),
        (MONEY_RE, "money"), (PRIVATE_RECORD_RE, "private-record"),
    ):
        if pattern.search(text):
            return reason
    scan = PATH_RE.sub(" ", URL_RE.sub(" ", text))
    for match in LONG_TOKEN_RE.finditer(scan):
        token = match.group(0)
        if not re.fullmatch(r"[0-9a-fA-F]{7,64}", token):
            return "long-token"
    match = CARD_RE.search(text)
    if match and len(re.sub(r"\D", "", match.group(0))) >= 13:
        return "card-number"
    return None


def recall_sensitive_reason(text: str) -> str | None:
    """Treat explicit POSIX source paths like the existing user-home paths."""
    reason = sensitive_reason(text)
    if reason != "long-token":
        return reason
    stripped = re.sub(r"(?<![A-Za-z0-9])/(?:[A-Za-z0-9_.-]+/)+[A-Za-z0-9_.-]+", " ", text)
    return sensitive_reason(stripped)


def redact_text(text: str, limit: int = 5000) -> str:
    lines = []
    for raw in str(text).splitlines():
        line = raw[:2000]
        lines.append("[REDACTED_SENSITIVE_LINE]" if sensitive_reason(line) else line)
    return "\n".join(lines)[:limit]


def redact_capture_text(text: str) -> str:
    """Privacy-filter complete physical lines without lossy length clipping."""
    return "\n".join(
        "[REDACTED_SENSITIVE_LINE]" if sensitive_reason(line) else line
        for line in str(text).splitlines()
    )


def safe_recall_prompt(text: str, limit: int = 900) -> str:
    """Redact values in place so a safe technical prompt keeps its meaning."""
    value = str(text)[:limit]
    technical_diagnosis = bool(re.search(
        r"(?i)\b(?:build|debug|error|failure|hook|job|scheduler|service|technical|worker)\b",
        value,
    ))
    private_matches = [match.group(0).casefold() for match in PRIVATE_RECORD_RE.finditer(value)]
    if private_matches and not (
        technical_diagnosis
        and all(term in {"diagnosis", "diagnosed"} for term in private_matches)
    ):
        return redact_text(value, limit=limit)
    for pattern in (
        SECRET_VALUE_RE, BEARER_RE, EMAIL_RE, PHONE_RE, SSN_RE, STREET_RE,
        MONEY_RE, CARD_RE, URL_RE, PATH_RE,
    ):
        value = pattern.sub("[REDACTED]", value)

    def redact_private(match: re.Match[str]) -> str:
        term = match.group(0)
        if technical_diagnosis and term.casefold() in {"diagnosis", "diagnosed"}:
            return term
        return "[REDACTED]"

    value = PRIVATE_RECORD_RE.sub(redact_private, value)

    def redact_long(match: re.Match[str]) -> str:
        token = match.group(0)
        # Preserve only the existing explicitly supported hash form.
        if re.fullmatch(r"[0-9a-fA-F]{7,64}", token):
            return token
        return "[REDACTED]"

    return LONG_TOKEN_RE.sub(redact_long, value)


def words(text: str) -> set[str]:
    normalized = str(text).replace("-", " ").replace("_", " ")
    return {m.group(0).lower().strip("._-") for m in WORD_RE.finditer(normalized) if len(m.group(0)) >= 3} - GENERIC_WORDS


def actual_user_text(text: str) -> str:
    clean = text.strip()
    if not clean or clean.startswith(SYNTHETIC_USER_PREFIXES):
        return ""
    if "<codex_delegation>" in clean:
        match = re.search(r"<input>(.*?)</input>", clean, re.S)
        return match.group(1).strip() if match else ""
    return clean


def content_text(content: Any) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    out = []
    for block in content:
        if isinstance(block, dict):
            value = block.get("text") or block.get("input_text") or block.get("output_text")
            if isinstance(value, str):
                out.append(value)
    return "\n".join(out)


def endpoint() -> str:
    value = os.environ.get("MEM0_FLEET_ENDPOINT", "").strip()
    if value:
        return value
    try:
        value = ENDPOINT_FILE.read_text(encoding="utf-8").strip()
        if value:
            return value
    except Exception:
        pass
    raise ValueError(
        "MEM0_FLEET_ENDPOINT or an explicit MEM0_FLEET_ENDPOINT_FILE is required"
    )


def parse_sse(raw: bytes) -> dict[str, Any]:
    text = raw.decode("utf-8", errors="replace")
    for line in text.splitlines():
        if line.startswith("data: "):
            value = json.loads(line[6:])
            return value if isinstance(value, dict) else {}
    try:
        value = json.loads(text)
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def _read_http_body(response: Any, deadline: float) -> bytes:
    """Read a streaming response without letting activity reset its deadline."""
    chunks: list[bytes] = []
    read1 = getattr(response, "read1", None)
    reader = read1 if callable(read1) else response.read
    amount = 64 * 1024 if callable(read1) else 1
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("MCP response exceeded its elapsed deadline")
        stream = getattr(response, "fp", None)
        raw = getattr(stream, "raw", None)
        sock = getattr(raw, "_sock", None)
        settimeout = getattr(sock, "settimeout", None)
        if callable(settimeout):
            settimeout(max(0.001, remaining))
        chunk = reader(amount)
        if not chunk:
            return b"".join(chunks)
        chunks.append(chunk)


def frozen_routing(value: dict[str, Any] | None = None) -> dict[str, str]:
    """Resolve only non-secret source routing references from a request."""
    nested = value.get("_routing") if isinstance(value, dict) else None
    nested = nested if isinstance(nested, dict) else {}
    machine = str((value or {}).get("machine") or nested.get("machine") or MACHINE)[:160]
    harness = str((value or {}).get("harness") or nested.get("harness") or HARNESS)[:160]
    token_ref = str(
        (value or {}).get("token_file")
        or nested.get("token_file")
        or TOKEN_FILE
    )[:2048]
    endpoint_ref = str(
        (value or {}).get("endpoint")
        or nested.get("endpoint")
        or endpoint()
    )[:2048]
    return {
        "machine": machine,
        "harness": harness,
        "token_file": token_ref,
        "endpoint": endpoint_ref,
    }


def http_rpc(
    payload: dict[str, Any], token: str, session: str = "", endpoint_value: str | None = None,
    timeout: float = 90.0,
) -> tuple[dict[str, Any], str]:
    timeout = float(timeout)
    if timeout <= 0:
        raise TimeoutError("MCP request deadline expired")
    deadline = time.monotonic() + timeout
    data = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer " + token,
        "User-Agent": "mem0-fleet-hook/1",
    }
    if session:
        headers["mcp-session-id"] = session
    request = urllib.request.Request(endpoint_value or endpoint(), data=data, headers=headers, method="POST")
    with urllib.request.urlopen(request, timeout=max(0.001, timeout), context=ssl.create_default_context()) as response:
        return parse_sse(_read_http_body(response, deadline)), response.headers.get("mcp-session-id", session)


def mcp_call(
    tool: str, args: dict[str, Any], routing: dict[str, Any] | None = None
) -> Any:
    test_key = "MEM0_FLEET_TEST_SEARCH_JSON" if tool == "memory_search" else "MEM0_FLEET_TEST_CAPTURE_JSON"
    if test_key in os.environ:
        return json.loads(os.environ[test_key])
    route = frozen_routing(routing)
    deadline = None
    try:
        if isinstance(routing, dict) and routing.get("_deadline") is not None:
            deadline = float(routing["_deadline"])
    except (TypeError, ValueError):
        deadline = None

    def call_timeout() -> float:
        if deadline is None:
            return 90.0
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("MCP request deadline expired")
        return min(90.0, remaining)

    token = Path(route["token_file"]).read_text(encoding="utf-8").strip()
    if not token:
        raise RuntimeError("empty token")
    init, session = http_rpc({
        "jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {
            "protocolVersion": "2025-06-18", "capabilities": {},
            "clientInfo": {"name": "mem0-fleet-hook", "version": "1"},
        }
    }, token, endpoint_value=route["endpoint"], timeout=call_timeout())
    # Stateless Streamable HTTP intentionally returns no session header.
    # Validate the initialization result; send a session only when supplied.
    if "error" in init or not isinstance(init.get("result"), dict) or not init["result"].get("protocolVersion"):
        raise RuntimeError("MCP initialize failed")
    http_rpc(
        {"jsonrpc": "2.0", "method": "notifications/initialized"},
        token,
        session,
        endpoint_value=route["endpoint"],
        timeout=call_timeout(),
    )
    result, _ = http_rpc({
        "jsonrpc": "2.0", "id": 2, "method": "tools/call",
        "params": {"name": tool, "arguments": args},
    }, token, session, endpoint_value=route["endpoint"], timeout=call_timeout())
    if "error" in result:
        raise RuntimeError("MCP tool failed")
    rpc_result = result.get("result")
    if isinstance(rpc_result, dict) and rpc_result.get("isError") is True:
        raise RuntimeError("MCP tool failed")
    if isinstance(rpc_result, list):
        return rpc_result
    for block in (rpc_result or {}).get("content") or []:
        if isinstance(block, dict) and block.get("type") == "text":
            value = block.get("text", "")
            try:
                return json.loads(value)
            except Exception:
                return value
    return None


def origin_slug(cwd: str) -> str:
    if not cwd or not Path(cwd).is_dir():
        return ""
    try:
        proc = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"], capture_output=True, text=True, timeout=2, check=False)
        raw = (proc.stdout or "").strip().rstrip("/")
        slug = raw.rsplit("/", 1)[-1]
        return slug[:-4] if slug.endswith(".git") else slug
    except Exception:
        return ""


def project_scope(cwd: str) -> str:
    return origin_slug(cwd) or (Path(cwd).name if cwd else "")


def _recall_stem(word: str) -> str:
    """Normalize only common inflections; avoid language-heavy dependencies."""
    if word.endswith("is"):
        return word
    if len(word) > 5 and word.endswith("ies"):
        return word[:-3] + "y"
    if len(word) > 5 and word.endswith("ing"):
        return word[:-3]
    if len(word) > 4 and word.endswith("ed"):
        return word[:-2]
    if len(word) > 4 and word.endswith(("ches", "shes", "sses", "xes", "zes")):
        return word[:-2]
    if len(word) > 3 and word.endswith("s"):
        return word[:-1]
    return word


def recall_terms(text: str) -> list[str]:
    """Return unique meaningful terms in their original order."""
    normalized = str(text).replace("-", " ").replace("_", " ")
    ordered: list[str] = []
    seen: set[str] = set()
    for match in WORD_RE.finditer(normalized):
        word = match.group(0).lower().strip("._-")
        if len(word) < 3 or word in RECALL_FILLER_WORDS:
            continue
        if word not in seen:
            seen.add(word)
            ordered.append(word)
    return ordered


def recall_roots(text: str) -> list[str]:
    """Return relevance-normalized terms while query hints stay readable."""
    roots: list[str] = []
    seen: set[str] = set()
    for word in recall_terms(text):
        root = _recall_stem(word)
        if root and root not in seen:
            seen.add(root)
            roots.append(root)
    return roots


def _date_keys(text: Any) -> set[str]:
    value = str(text or "")
    dates = set(_ISO_DATE_RE.findall(value))
    for month, day, year in _MONTH_DAY_RE.findall(value):
        dates.add(f"{int(year) if year else datetime.now(ZoneInfo('America/Denver')).year:04d}-{_MONTH_NUMBER[month.lower()]}-{int(day):02d}")
    valid = set()
    for date in dates:
        try:
            datetime.strptime(date, "%Y-%m-%d")
        except ValueError:
            continue
        valid.add(date)
    return valid


def _row_date_keys(row: dict[str, Any]) -> set[str]:
    # A later ingestion timestamp must never make an explicitly old fact current.
    dates = _date_keys(row_text(row))
    if dates:
        return dates
    metadata = row.get("metadata") if isinstance(row.get("metadata"), dict) else {}
    for name in ("valid_at", "validAt", "observed_at", "thread_date"):
        dates = _date_keys(metadata.get(name))
        if dates:
            return dates
    return set()


def recall_query(cwd: str, prompt: str) -> str:
    """Keep semantic word order, then add one workspace and anchor hint."""
    project = project_scope(cwd)
    safe_prompt = re.sub(r"\s+", " ", safe_recall_prompt(prompt)).strip()
    anchors = " ".join(recall_terms(safe_prompt)[:16])
    parts = [safe_prompt]
    if project and project.casefold() not in safe_prompt.casefold():
        parts.append(f"Workspace: {project}")
    if anchors:
        parts.append(f"Topic anchors: {anchors}")
    return " ".join(part for part in parts if part)[:1200]


def row_text(row: dict[str, Any]) -> str:
    return str(row.get("memory") or row.get("text") or "").strip()


def row_source(row: dict[str, Any]) -> str:
    meta = row.get("metadata") or {}
    return str(meta.get("source") or meta.get("transcript_path") or row.get("agent") or "unknown")


def row_id(row: dict[str, Any]) -> str:
    return str(row.get("id") or row.get("memory_id") or "").strip()


def _row_context_labels(row: dict[str, Any]) -> str:
    """Add compact source-time-validity labels when the server supplies them."""
    metadata = row.get("metadata") if isinstance(row.get("metadata"), dict) else {}
    timestamp = next(
        (
            metadata.get(key)
            for key in ("updated_at", "updatedAt", "created_at", "createdAt", "time")
            if metadata.get(key) not in (None, "")
        ),
        None,
    )
    validity = next(
        (
            metadata.get(key)
            for key in ("validity", "valid_until", "validUntil", "verified")
            if metadata.get(key) not in (None, "")
        ),
        None,
    )
    labels: list[str] = []
    if timestamp is not None:
        labels.append("time=" + _escape_prepare_delimiters(str(timestamp))[:80])
    if validity is not None:
        labels.append("validity=" + _escape_prepare_delimiters(str(validity))[:80])
    return ("; " + "; ".join(labels)) if labels else ""


def _scope_identity(row: dict[str, Any]) -> str:
    metadata = row.get("metadata")
    metadata_has_scope = isinstance(metadata, dict) and "scope" in metadata
    row_has_scope = "scope" in row
    if metadata_has_scope and row_has_scope and metadata["scope"] != row["scope"]:
        return "conflict:" + repr((metadata["scope"], row["scope"]))
    if metadata_has_scope:
        return "scope:" + repr(metadata["scope"])
    if row_has_scope:
        return "scope:" + repr(row["scope"])
    return "missing-scope"


def same_scope_text_key(row: dict[str, Any]) -> str:
    text = re.sub(r"\s+", " ", row_text(row)).strip()
    if not text:
        return ""
    return sha256_text(f"{_scope_identity(row)}\0{text}")


def _is_graph_row(row: dict[str, Any]) -> bool:
    metadata = row.get("metadata") or {}
    return (
        row.get("is_graph") is True
        or metadata.get("source") == "graphiti"
        or metadata.get("is_graph") is True
    )


_MEMORY_SELECTION: Any = None


def load_memory_selection() -> Any:
    """Load the shipped selector from this hook's sibling directory."""
    global _MEMORY_SELECTION
    if _MEMORY_SELECTION is None:
        spec = importlib.util.spec_from_file_location(
            "memory_selection_fleet_hook", str(MEMORY_SELECTION_PATH)
        )
        if spec is None or spec.loader is None:
            raise ImportError("memory_selection is unavailable")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        _MEMORY_SELECTION = module
    return _MEMORY_SELECTION


def rank_rows(rows: list[dict[str, Any]], cwd: str, prompt: str) -> list[dict[str, Any]]:
    """Return only rows with prompt-specific evidence, or one strong paraphrase."""
    prompt_terms = recall_roots(prompt)
    project_terms = set(recall_roots(project_scope(cwd)))
    intent = [term for term in prompt_terms if term not in project_terms]
    if not intent:
        return []
    wanted = set(intent)
    central = set(intent[:CENTRAL_ANCHOR_COUNT])
    requested_dates = _date_keys(prompt)
    scored: list[tuple[float, int, float, dict[str, Any]]] = []
    for row in rows:
        text = row_text(row)
        metadata = row.get("metadata") if isinstance(row.get("metadata"), dict) else {}
        explicit_project = str(metadata.get("project") or "").strip().casefold()
        if explicit_project and project_scope(cwd) and explicit_project != project_scope(cwd).casefold():
            continue
        if not text or recall_sensitive_reason(text) or PROMPT_ECHO_RE.match(text):
            continue
        raw_score = row.get("score")
        semantic = float(raw_score) if isinstance(raw_score, (int, float)) else 0.0
        if semantic < max(MIN_SCORE, MIN_RELEVANT_SEMANTIC):
            continue
        row_terms = set(recall_roots(text))
        overlap = len(wanted & row_terms)
        central_overlap = len(central & row_terms)
        subject_overlap = len(project_terms & row_terms)
        row_dates = _row_date_keys(row)
        date_match = bool(requested_dates & row_dates)
        if requested_dates and not date_match:
            continue
        strong_lexical = overlap >= 3 and central_overlap > 0
        focused_lexical = (
            overlap >= 2 and central_overlap > 0 and subject_overlap > 0
        )
        narrow_lexical = (
            overlap >= 1
            and central_overlap > 0
            and subject_overlap > 0
            and (date_match or semantic >= 0.72)
        )
        lexical_support = strong_lexical or focused_lexical or narrow_lexical
        if lexical_support and not strong_lexical and semantic < 0.70:
            lexical_support = False
        semantic_paraphrase = semantic >= STRONG_PARAPHRASE_SCORE
        if not lexical_support and not semantic_paraphrase:
            continue
        confidence = (
            semantic
            + min(overlap, 4) * 0.055
            + min(central_overlap, 2) * 0.04
            + min(subject_overlap, 2) * 0.02
            + (0.06 if date_match else 0.0)
        )
        scored.append((confidence, overlap, semantic, row))
    if not scored:
        return []
    scored.sort(key=lambda item: (item[0], item[1], item[2]), reverse=True)
    best_confidence, best_overlap, _, _ = scored[0]
    variable_limit = min(MAX_RECALL_ITEMS, 3, 1 + min(3, best_overlap))
    if best_overlap == 0:
        variable_limit = 1
    return [
        row
        for confidence, _, _, row in scored
        if confidence >= best_confidence - RELEVANCE_WINDOW
    ][:variable_limit]


def select_recall_rows(rows: list[dict[str, Any]], limit: int = MAX_RECALL_ITEMS) -> list[dict[str, Any]]:
    """Apply graph eligibility and the shared selector after unseen filtering."""
    graph_count = 0
    eligible: list[dict[str, Any]] = []
    for row in rows:
        if _is_graph_row(row):
            if graph_count >= 2:
                continue
            graph_count += 1
        eligible.append(row)
    return list(load_memory_selection().select_rows(
        eligible, limit, add_single_provenance=False
    ))


def format_context_with_emitted_rows(
    rows: list[dict[str, Any]], cwd: str
) -> tuple[str, list[dict[str, Any]]]:
    if not rows:
        return "", []
    lines = [AUTHORITY_NOTICE, f"Scope: project={project_scope(cwd) or 'unscoped'}; machine={MACHINE}.", "Memory candidates:"]
    emitted: list[dict[str, Any]] = []
    for row in rows:
        score = row.get("score")
        score_text = f"{float(score):.3f}" if isinstance(score, (int, float)) else "n/a"
        line = f"- {row_text(row).replace(chr(10), ' ')} [id={row.get('id') or 'unknown'}; score={score_text}; source={row_source(row)}{_row_context_labels(row)}]"
        if len("\n".join(lines + [line])) // 4 > MAX_RECALL_TOKENS:
            break
        lines.append(line)
        emitted.append(row)
    return ("\n".join(lines), emitted) if emitted else ("", [])


def format_context(rows: list[dict[str, Any]], cwd: str) -> str:
    return format_context_with_emitted_rows(rows, cwd)[0]


def _escape_prepare_delimiters(value: str) -> str:
    """Keep candidate text from opening or closing the hook-owned wrapper."""
    return (
        str(value)
        .replace("<system-reminder>", "<system-reminder-escaped>")
        .replace("</system-reminder>", "</system-reminder-escaped>")
    )


def format_prepare_context(
    rows: list[dict[str, Any]], cwd: str
) -> tuple[str, list[dict[str, Any]]]:
    """Build the one plain, bounded wrapper sent to the native Grok client."""
    if not rows:
        return "", []
    safe_rows: list[dict[str, Any]] = []
    for row in rows:
        safe = dict(row)
        text = row_text(row)
        if "memory" in safe:
            safe["memory"] = _escape_prepare_delimiters(text)
        else:
            safe["text"] = _escape_prepare_delimiters(text)
        if row_id(row):
            safe["id"] = _escape_prepare_delimiters(row_id(row))
        metadata = safe.get("metadata")
        if isinstance(metadata, dict):
            metadata = dict(metadata)
            for key in ("source", "transcript_path", "updated_at", "updatedAt", "created_at", "createdAt", "time", "validity", "valid_until", "validUntil", "verified"):
                if metadata.get(key) not in (None, ""):
                    metadata[key] = _escape_prepare_delimiters(str(metadata[key]))
            safe["metadata"] = metadata
        safe_rows.append(safe)
    body, safe_emitted = format_context_with_emitted_rows(safe_rows, cwd)
    if not body:
        return "", []
    emitted: list[dict[str, Any]] = []
    for safe in safe_emitted:
        index = safe_rows.index(safe)
        emitted.append(rows[index])
    while emitted:
        wrapper = f"<system-reminder>\n{body}\n</system-reminder>\n"
        if len(wrapper) // 4 <= MAX_RECALL_TOKENS:
            return wrapper, emitted
        emitted.pop()
        body, safe_emitted = format_context_with_emitted_rows(
            safe_rows[: len(emitted)], cwd
        )
    return "", []


def generation_path(session: str) -> Path:
    return STATE / safe_component(MACHINE) / safe_component(HARNESS) / "generations" / f"{safe_component(session)}.json"


def _read_object(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return value if isinstance(value, dict) else {}


def _bounded_strings(value: Any, limit: int) -> list[str]:
    if not isinstance(value, list):
        return []
    out: list[str] = []
    for item in value:
        if item in (None, ""):
            continue
        value_text = str(item)[:256]
        if value_text not in out:
            out.append(value_text)
        if len(out) >= limit:
            break
    return out


def _bounded_count(value: Any) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def empty_generation_state(session: str, generation: str, source: str = "") -> dict[str, Any]:
    state = {
        "state_version": 3,
        "session": session[:160],
        "source": source[:160],
        "generation": generation[:64],
        "injection_count": 0,
        "topic_known": False,
        "last_project": "",
        "last_topic_tokens": [],
        "last_prompt_sha256": "",
        "seen_ids": [],
        "seen_texts": [],
    }
    if HARNESS == "grok":
        state["delivery_contract"] = GROK_DELIVERY_CONTRACT
    return state


def load_generation_state(session: str, generation: str) -> dict[str, Any]:
    stored = _read_object(generation_path(session))
    state = empty_generation_state(
        session,
        generation,
        str(stored.get("source") or "") if stored.get("generation") == generation else "",
    )
    if stored.get("generation") != generation:
        return state
    if HARNESS == "grok" and stored.get("delivery_contract") != GROK_DELIVERY_CONTRACT:
        # The previous passive/ PostTool path could mark rows before delivery.
        # The client-boundary contract starts with a clean Grok ledger only.
        return state
    state.update({
        "injection_count": min(
            MAX_GENERATION_INJECTIONS,
            max(0, _bounded_count(stored.get("injection_count"))),
        ),
        "topic_known": bool(stored.get("topic_known")),
        "last_project": str(stored.get("last_project") or "")[:160],
        "last_topic_tokens": _bounded_strings(
            stored.get("last_topic_tokens"), MAX_TOPIC_TOKENS
        ),
        "last_prompt_sha256": str(stored.get("last_prompt_sha256") or "")[:64],
        "seen_ids": _bounded_strings(stored.get("seen_ids"), MAX_SEEN_ROWS_PER_GENERATION),
        "seen_texts": _bounded_strings(stored.get("seen_texts"), MAX_SEEN_ROWS_PER_GENERATION),
    })
    if isinstance(stored.get("accepted_packet"), dict):
        packet = stored["accepted_packet"]
        state["accepted_packet"] = {
            key: packet[key]
            for key in (
                "version", "status", "cwd_sha256", "context", "context_sha256",
                "selected_count", "prepared_at", "emitted_at", "replayed_at",
                "replay_count", "source_expiry",
            )
            if key in packet
        }
    for key in ("last_compaction_fingerprint", "pending_compaction_fingerprint"):
        fingerprint = str(stored.get(key) or "")
        if re.fullmatch(r"[0-9a-f]{64}", fingerprint):
            state[key] = fingerprint
    return state


def workspace_fingerprint(cwd: str) -> str:
    """Hash one existing absolute workspace path without retaining the path."""
    try:
        path = Path(str(cwd).strip())
        if not path.is_absolute() or not path.is_dir():
            return ""
        return sha256_text(str(path.resolve(strict=True)))
    except (OSError, RuntimeError):
        return ""


def valid_codex_context(context: Any) -> bool:
    return (
        isinstance(context, str)
        and 0 < len(context) <= MAX_RECALL_CONTEXT_CHARS
        and context.startswith(AUTHORITY_NOTICE + "\nScope: ")
        and "\nMemory candidates:\n- " in context
    )


def valid_codex_packet(packet: Any, cwd: str, status: str) -> bool:
    if not isinstance(packet, dict):
        return False
    context = packet.get("context")
    selected_count = _bounded_count(packet.get("selected_count"))
    cwd_sha256 = workspace_fingerprint(cwd)
    return (
        packet.get("version") == CODEX_PACKET_VERSION
        and packet.get("status") == status
        and bool(cwd_sha256)
        and packet.get("cwd_sha256") == cwd_sha256
        and 1 <= selected_count <= MAX_RECALL_ITEMS
        and valid_codex_context(context)
        and packet.get("context_sha256") == sha256_text(context)
    )


def fresh_codex_emission(packet: Any) -> bool:
    """Bound replay age to the original successful UserPromptSubmit emission."""
    if not isinstance(packet, dict):
        return False
    emitted_at = packet.get("emitted_at")
    if not isinstance(emitted_at, str) or not emitted_at:
        return False
    try:
        stamp = datetime.fromisoformat(emitted_at)
        if stamp.tzinfo is None or stamp.utcoffset() is None:
            return False
        age_seconds = time.time() - stamp.timestamp()
    except (OverflowError, OSError, TypeError, ValueError):
        return False
    if not 0 <= age_seconds <= CODEX_PACKET_MAX_AGE_SECONDS:
        return False
    source_expiry = packet.get("source_expiry")
    if source_expiry in (None, ""):
        return True
    if not isinstance(source_expiry, str) or not re.fullmatch(
        r"\d{4}-\d{2}-\d{2}", source_expiry
    ):
        return False
    try:
        expiry_date = datetime.strptime(source_expiry, "%Y-%m-%d").date()
    except ValueError:
        return False
    return expiry_date >= datetime.now(ZoneInfo("UTC")).date()


def emitted_source_expiry(rows: list[dict[str, Any]]) -> str:
    """Retain only the earliest unambiguous active source-expiry date."""
    selector = load_memory_selection()
    classify = getattr(selector, "explicit_expiry_state", None)
    if not callable(classify):
        return ""
    expiries: list[str] = []
    for row in rows[:MAX_RECALL_ITEMS]:
        try:
            expiry_state = classify(row)
        except Exception:
            continue
        if expiry_state != "active":
            continue
        pending = [row]
        seen: set[int] = set()
        while pending:
            container = pending.pop(0)
            if not isinstance(container, dict) or id(container) in seen:
                continue
            seen.add(id(container))
            for key in ("expiration_date", "expires_at", "valid_until"):
                raw = container.get(key)
                if isinstance(raw, str) and re.fullmatch(r"\d{4}-\d{2}-\d{2}", raw):
                    expiries.append(raw)
                    break
            for key in ("metadata", "payload"):
                nested = container.get(key)
                if isinstance(nested, dict):
                    pending.append(nested)
    return min(expiries) if expiries else ""


def commit_codex_packet(payload: dict[str, Any], output: str, mode: str) -> None:
    """Accept a prepared packet only after its hook output was flushed."""
    if HARNESS != "codex" or HOOK_OFF.exists() or is_subagent(payload):
        return
    session = str(pick(payload, "session_id", "sessionId", default="unknown"))
    cwd = str(pick(payload, "cwd", default=""))
    try:
        envelope = json.loads(output)
        specific = envelope.get("hookSpecificOutput")
        event_name = specific.get("hookEventName") if isinstance(specific, dict) else ""
        if (
            (mode == "start" and event_name != "UserPromptSubmit")
            or (mode == "prime" and event_name != "SessionStart")
            or mode not in {"start", "prime"}
            or (mode == "prime" and not is_compaction_prime(payload))
        ):
            return
        context = specific.get("additionalContext")
        generation = current_generation(session)
        with file_lock(session_lock_path(session), nonblocking=False):
            state = load_generation_state(session, generation)
            packet = state.get("accepted_packet")
            if (
                state.get("session") != session[:160]
                or not valid_codex_packet(packet, cwd, "PREPARED")
                or packet.get("context") != context
            ):
                log_event("codex-commit", "SKIP_MISMATCH", session=session, generation=generation)
                return
            if mode == "start":
                packet["status"] = "EMITTED"
                packet["emitted_at"] = now_mdt()
            else:
                pending_fingerprint = str(
                    state.get("pending_compaction_fingerprint") or ""
                )
                if (
                    not re.fullmatch(r"[0-9a-f]{64}", pending_fingerprint)
                    or not fresh_codex_emission(packet)
                ):
                    log_event(
                        "codex-commit", "SKIP_MISMATCH", session=session,
                        generation=generation,
                    )
                    return
                packet["status"] = "EMITTED"
                packet["replayed_at"] = now_mdt()
                packet["replay_count"] = min(
                    MAX_GENERATION_INJECTIONS,
                    max(0, _bounded_count(packet.get("replay_count"))) + 1,
                )
                state["injection_count"] = 1
                state["last_compaction_fingerprint"] = pending_fingerprint
                state.pop("pending_compaction_fingerprint", None)
            state["accepted_packet"] = packet
            atomic_json(generation_path(session), state)
        log_event(
            "codex-commit", "PASS", session=session, generation=generation,
            count=_bounded_count(packet.get("selected_count")), event_name=event_name,
        )
    except Exception:
        log_event("codex-commit", "FAIL_OPEN", session=session)


def topic_tokens(prompt: str) -> frozenset[str]:
    # Topic overlap needs equality only. Keep prompt words and sensitive
    # values out of the persistent generation and pending-delivery ledgers.
    return frozenset(
        sha256_text(word)
        for word in words(prompt) - TOPIC_FILLER_WORDS
    )


def material_topic_change(
    generation_state: dict[str, Any], project: str, prompt: str
) -> bool:
    if _bounded_count(generation_state.get("injection_count")) >= MAX_GENERATION_INJECTIONS:
        return False
    if not generation_state.get("topic_known"):
        prior_prompt = str(generation_state.get("last_prompt_sha256") or "")
        return not prior_prompt or prior_prompt != sha256_text(prompt)

    prior_project = str(generation_state.get("last_project") or "")
    if prior_project != project and (prior_project or project):
        return True

    prior_tokens = set(_bounded_strings(generation_state.get("last_topic_tokens"), MAX_TOPIC_TOKENS))
    current_tokens = set(topic_tokens(prompt))
    if not prior_tokens and not current_tokens:
        return False
    if not current_tokens:
        return False
    if not prior_tokens:
        return True
    shared_tokens = len(prior_tokens & current_tokens)
    combined_tokens = len(prior_tokens | current_tokens)
    if shared_tokens < 2:
        return combined_tokens > shared_tokens
    similarity = shared_tokens / combined_tokens
    return similarity < MIN_TOPIC_SIMILARITY


def unseen_rows(
    rows: list[dict[str, Any]], generation_state: dict[str, Any]
) -> list[dict[str, Any]]:
    seen_ids = set(_bounded_strings(generation_state.get("seen_ids"), MAX_SEEN_ROWS_PER_GENERATION))
    seen_texts = set(_bounded_strings(generation_state.get("seen_texts"), MAX_SEEN_ROWS_PER_GENERATION))
    fresh: list[dict[str, Any]] = []
    for row in rows:
        identifier = row_id(row)
        text_key = same_scope_text_key(row)
        if identifier and identifier in seen_ids:
            continue
        if text_key and text_key in seen_texts:
            continue
        fresh.append(row)
    return fresh


def update_generation_state(
    generation_state: dict[str, Any], project: str, prompt: str,
    emitted_rows: list[dict[str, Any]],
) -> dict[str, Any]:
    generation_state["topic_known"] = True
    generation_state["last_project"] = project[:160]
    generation_state["last_topic_tokens"] = sorted(topic_tokens(prompt))[:MAX_TOPIC_TOKENS]
    generation_state["last_prompt_sha256"] = sha256_text(prompt)
    if emitted_rows:
        generation_state["injection_count"] = min(
            MAX_GENERATION_INJECTIONS,
            _bounded_count(generation_state.get("injection_count")) + 1,
        )
        seen_ids = _bounded_strings(generation_state.get("seen_ids"), MAX_SEEN_ROWS_PER_GENERATION)
        seen_texts = _bounded_strings(generation_state.get("seen_texts"), MAX_SEEN_ROWS_PER_GENERATION)
        for row in emitted_rows:
            identifier = row_id(row)
            text_key = same_scope_text_key(row)
            if identifier and identifier not in seen_ids:
                seen_ids.append(identifier)
            if text_key and text_key not in seen_texts:
                seen_texts.append(text_key)
        generation_state["seen_ids"] = seen_ids[:MAX_SEEN_ROWS_PER_GENERATION]
        generation_state["seen_texts"] = seen_texts[:MAX_SEEN_ROWS_PER_GENERATION]
    return generation_state


def is_compaction_prime(payload: dict[str, Any]) -> bool:
    for key in ("compact", "compaction", "is_compaction"):
        if payload.get(key) is True:
            return True
    markers = (
        pick(payload, "source", default=""),
        pick(payload, "reason", default=""),
        pick(payload, "hook_event_name", "hookEventName", default=""),
    )
    return any("compact" in str(marker).lower() for marker in markers)


def grok_digest_path() -> Path:
    raw = os.environ.get("BORG_GROK_MEMORY_FILE")
    if not raw:
        raise ValueError("BORG_GROK_MEMORY_FILE is required for Grok injection")
    return Path(raw).expanduser()


def handle_prime(payload: dict[str, Any], caller: Callable[[str, dict[str, Any]], Any] = mcp_call) -> str:
    if HOOK_OFF.exists() or is_subagent(payload):
        if HARNESS == "grok":
            try:
                grok_digest_path().unlink(missing_ok=True)
            except Exception:
                pass
        return ""
    session = str(pick(payload, "session_id", "sessionId", default="unknown"))
    source = str(pick(payload, "source", default="startup"))
    cwd = str(pick(payload, "cwd", default=""))
    transcript = str(pick(payload, "transcript_path", "transcriptPath", default=""))
    try:
        size = Path(transcript).stat().st_size if transcript and Path(transcript).is_file() else 0
    except OSError:
        size = 0
    replay_context = ""
    replay_count = 0
    duplicate_compaction = False
    retrying_prepared_replay = False
    write_state = True
    with file_lock(session_lock_path(session), nonblocking=False):
        previous = _read_object(generation_path(session))
        previous_generation = str(previous.get("generation") or "")
        previous_state = (
            load_generation_state(session, previous_generation)
            if previous_generation else {}
        )
        compact = is_compaction_prime(payload)
        compaction_fingerprint = sha256_text(
            f"{session}\0{source}\0{transcript}\0{size}\0{workspace_fingerprint(cwd)}"
        )
        if (
            compact
            and HARNESS == "codex"
            and previous_state.get("last_compaction_fingerprint") == compaction_fingerprint
        ):
            duplicate_compaction = True
            generation = previous_generation
            state = previous_state
            write_state = False
        elif (
            compact
            and HARNESS == "codex"
            and previous_state.get("pending_compaction_fingerprint")
            == compaction_fingerprint
            and valid_codex_packet(
                previous_state.get("accepted_packet"), cwd, "PREPARED"
            )
            and fresh_codex_emission(previous_state.get("accepted_packet"))
        ):
            # A prior output did not commit. Re-emit the exact prepared packet;
            # neither delivery count nor duplicate suppression was consumed.
            generation = previous_generation
            state = previous_state
            accepted = state["accepted_packet"]
            replay_context = str(accepted["context"])
            replay_count = _bounded_count(accepted.get("selected_count"))
            retrying_prepared_replay = True
            write_state = False
        elif compact:
            accepted = previous_state.get("accepted_packet")
            prior_pending = str(
                previous_state.get("pending_compaction_fingerprint") or ""
            )
            accepted_is_delivered = (
                HARNESS == "codex"
                and previous_state.get("session") == session[:160]
                and fresh_codex_emission(accepted)
                and (
                    valid_codex_packet(accepted, cwd, "EMITTED")
                    or (
                        re.fullmatch(r"[0-9a-f]{64}", prior_pending) is not None
                        and valid_codex_packet(accepted, cwd, "PREPARED")
                    )
                )
            )
            if not accepted_is_delivered:
                accepted = None
            generation = sha256_text(
                f"{session}\0{source}\0{transcript}\0{size}\0{previous_generation}\0{time.time_ns()}"
            )[:20]
            state = empty_generation_state(session, generation, source)
            if accepted is not None:
                accepted = dict(accepted)
                replay_context = str(accepted["context"])
                replay_count = _bounded_count(accepted.get("selected_count"))
                accepted["status"] = "PREPARED"
                state["accepted_packet"] = accepted
                state["pending_compaction_fingerprint"] = compaction_fingerprint
                state["topic_known"] = True
                state["last_project"] = previous_state.get("last_project", "")
                state["last_topic_tokens"] = previous_state.get("last_topic_tokens", [])
                state["last_prompt_sha256"] = previous_state.get("last_prompt_sha256", "")
                state["seen_ids"] = previous_state.get("seen_ids", [])
                state["seen_texts"] = previous_state.get("seen_texts", [])
        elif HARNESS == "grok" and previous_generation:
            # Native resume keeps its delivery generation across passive starts.
            generation = previous_generation
            state = load_generation_state(session, generation)
            state["source"] = source[:160]
        else:
            generation = sha256_text(f"{session}\0{source}\0{transcript}\0{size}")[:20]
            state = load_generation_state(session, generation)
            state["source"] = source[:160]
            if HARNESS == "codex":
                state.pop("accepted_packet", None)
                state.pop("last_compaction_fingerprint", None)
                state.pop("pending_compaction_fingerprint", None)
        if write_state:
            atomic_json(generation_path(session), state)
            if HARNESS == "grok" and compact:
                _retire_grok_pending_for_generation(session, previous_generation)
    if duplicate_compaction:
        log_event(
            "prime", "SKIP_DUP", session=session, generation=generation,
            reason="duplicate-compaction",
        )
        return ""
    log_event(
        "prime", "PREPARED" if replay_context else "PASS",
        session=session, generation=generation,
        count=replay_count if replay_context else None,
        reason=(
            "compaction-retry" if retrying_prepared_replay
            else "compaction-replay" if replay_context
            else "compaction-reset"
        ) if compact else None,
    )
    if HARNESS == "grok":
        # SessionStart/PostCompact are state markers. Grok only consumes a
        # candidate after a client-boundary prepare has been accepted.
        log_event(
            "grok-prime", "PASS_EMPTY", session=session, generation=generation,
            reason="state-only",
        )
    if replay_context:
        return json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "SessionStart",
                    "additionalContext": replay_context,
                }
            },
            ensure_ascii=False,
        )
    return ""


def current_generation(session: str) -> str:
    try:
        value = json.loads(generation_path(session).read_text(encoding="utf-8")).get("generation")
        if value:
            return str(value)
    except Exception:
        pass
    return sha256_text(session + "\0fallback")[:20]


def grok_pending_dir(machine: str | None = None, harness: str | None = None) -> Path:
    return state_root(machine, harness) / "pending"


def grok_pending_path(
    session: str,
    turn: str,
    channel: str = "client_prompt",
    machine: str | None = None,
    harness: str | None = None,
) -> Path:
    key = sha256_text(f"{turn}\0{channel}")[:32]
    return grok_pending_dir(machine, harness) / f"{safe_component(session)}-{key}.json"


def _grok_client_field(
    payload: dict[str, Any], keys: tuple[str, ...], limit: int = 512
) -> str:
    value = pick(payload, *keys, default="")
    if value in (None, ""):
        return ""
    text = str(value).strip()
    if not text or len(text) > limit:
        return ""
    if any(unicodedata.category(char).startswith("C") for char in text):
        return ""
    return text


def _grok_prepare_fields(payload: dict[str, Any]) -> dict[str, str]:
    session = _grok_client_field(payload, ("session_id", "sessionId"), 160)
    turn = _grok_client_field(
        payload,
        ("turn_id", "turnId", "prompt_id", "promptId", "tool_use_id", "toolUseId"),
        256,
    )
    cwd = _grok_client_field(payload, ("cwd", "workspaceRoot", "workspace_root"), 2048)
    prompt_value = pick(payload, "prompt", default="")
    prompt = str(prompt_value) if prompt_value not in (None, "") else ""
    if len(prompt) > 12000:
        return {}
    channel = _grok_client_field(
        payload, ("delivery_channel", "deliveryChannel", "channel"), 32
    ) or "client_prompt"
    if channel not in {"client_prompt", "pre_tool"}:
        return {}
    if not session or not turn or not cwd or not Path(cwd).is_absolute() or not prompt:
        return {}
    return {"session": session, "turn": turn, "cwd": cwd, "prompt": prompt, "channel": channel}


def _grok_pending_paths(session: str, machine: str | None = None, harness: str | None = None) -> list[Path]:
    directory = grok_pending_dir(machine, harness)
    try:
        return sorted(
            path for path in directory.glob(f"{safe_component(session)}-*.json")
            if path.is_file()
        )
    except OSError:
        return []


def _retire_grok_pending_for_generation(session: str, generation: str) -> None:
    if not session or not generation:
        return
    for path in _grok_pending_paths(session):
        pending = _read_object(path)
        if pending.get("generation") != generation or pending.get("status") != "PREPARED":
            continue
        pending["status"] = "STALE"
        pending["retired_at"] = now_mdt()
        atomic_json(path, pending)


def _grok_generation_for_prepare(session: str, payload: dict[str, Any]) -> str:
    current = current_generation(session)
    requested = _grok_client_field(payload, ("generation", "generationId"), 64)
    return current if not requested else requested if requested == current else ""


def _rotate_grok_generation(session: str, payload: dict[str, Any]) -> str:
    previous = current_generation(session)
    source = str(pick(payload, "source", "reason", default="compaction"))[:160]
    transcript = str(pick(payload, "transcript_path", "transcriptPath", default=""))[:2048]
    generation = sha256_text(
        f"{session}\0{source}\0{transcript}\0{previous}\0{time.time_ns()}"
    )[:20]
    with file_lock(session_lock_path(session), nonblocking=False):
        if current_generation(session) != previous:
            return current_generation(session)
        atomic_json(generation_path(session), empty_generation_state(session, generation, source))
        _retire_grok_pending_for_generation(session, previous)
    return generation


def _pending_selected_ids(pending: dict[str, Any]) -> list[str]:
    return _bounded_strings(pending.get("selected_ids"), MAX_SEEN_ROWS_PER_GENERATION)


def _pending_selected_texts(pending: dict[str, Any]) -> list[str]:
    values = _bounded_strings(pending.get("selected_text_keys"), MAX_SEEN_ROWS_PER_GENERATION)
    return [value for value in values if re.fullmatch(r"[0-9a-f]{64}", value)]


def _apply_grok_pending_state(
    state: dict[str, Any], pending: dict[str, Any]
) -> dict[str, Any]:
    state["topic_known"] = True
    state["last_project"] = str(pending.get("project") or "")[:160]
    state["last_topic_tokens"] = _bounded_strings(
        pending.get("topic_tokens"), MAX_TOPIC_TOKENS
    )
    state["last_prompt_sha256"] = str(pending.get("prompt_sha256") or "")[:64]
    selected_ids = _pending_selected_ids(pending)
    selected_texts = _pending_selected_texts(pending)
    if selected_ids or selected_texts:
        state["injection_count"] = min(
            MAX_GENERATION_INJECTIONS,
            _bounded_count(state.get("injection_count")) + 1,
        )
        seen_ids = _bounded_strings(state.get("seen_ids"), MAX_SEEN_ROWS_PER_GENERATION)
        seen_texts = _bounded_strings(state.get("seen_texts"), MAX_SEEN_ROWS_PER_GENERATION)
        for value in selected_ids:
            if value not in seen_ids:
                seen_ids.append(value)
        for value in selected_texts:
            if value not in seen_texts:
                seen_texts.append(value)
        state["seen_ids"] = seen_ids[:MAX_SEEN_ROWS_PER_GENERATION]
        state["seen_texts"] = seen_texts[:MAX_SEEN_ROWS_PER_GENERATION]
    return state


def handle_grok_commit(payload: dict[str, Any]) -> str:
    """Commit one previously prepared client block after native acceptance."""
    if HARNESS != "grok" or HOOK_OFF.exists() or is_grok_subagent(payload):
        return ""
    session = _grok_client_field(payload, ("session_id", "sessionId"), 160)
    turn = _grok_client_field(payload, ("turn_id", "turnId"), 256)
    channel = _grok_client_field(
        payload, ("delivery_channel", "deliveryChannel", "channel"), 32
    ) or "client_prompt"
    context_hash = _grok_client_field(
        payload, ("context_sha256", "contextSha256"), 64
    )
    if (
        not session
        or not turn
        or channel not in {"client_prompt", "pre_tool"}
        or not re.fullmatch(r"[0-9a-f]{64}", context_hash)
    ):
        return ""
    pending_path = grok_pending_path(session, turn, channel)
    try:
        with file_lock(session_lock_path(session), nonblocking=False):
            pending = _read_object(pending_path)
            if not pending:
                log_event("grok-commit", "SKIP_MISSING", session=session, turn=turn)
                return ""
            if (
                pending.get("session") != session
                or pending.get("turn") != turn
                or pending.get("channel") != channel
                or pending.get("context_sha256") != context_hash
            ):
                log_event("grok-commit", "SKIP_MISMATCH", session=session, turn=turn)
                return ""
            if pending.get("status") == "COMMITTED":
                log_event("grok-commit", "PASS", session=session, turn=turn, reason="idempotent")
                return ""
            if pending.get("status") != "PREPARED":
                log_event("grok-commit", "SKIP_STALE", session=session, turn=turn)
                return ""
            generation = str(pending.get("generation") or "")
            if not generation or current_generation(session) != generation:
                log_event("grok-commit", "SKIP_STALE", session=session, turn=turn)
                return ""
            state = load_generation_state(session, generation)
            state = _apply_grok_pending_state(state, pending)
            state["delivery_contract"] = GROK_DELIVERY_CONTRACT
            atomic_json(generation_path(session), state)
            pending["status"] = "COMMITTED"
            pending["committed_at"] = now_mdt()
            atomic_json(pending_path, pending)
            log_event(
                "grok-commit", "PASS", session=session, turn=turn,
                generation=generation, count=_bounded_count(pending.get("selected_count")),
            )
    except Exception:
        log_event("grok-commit", "FAIL_OPEN", session=session, turn=turn)
    return ""


def graph_context_needed(prompt: str) -> bool:
    """Request bounded graph candidates for relationships and past decisions."""
    return bool(re.search(
        r"\b(?:relationships?|depend(?:s|encies|ency)?|decisions?|why|history|"
        r"timeline|changed|superseded|owners?|responsible|connected|architecture|"
        r"previous|earlier)\b", prompt, re.IGNORECASE,
    ))


def handle_start(
    payload: dict[str, Any],
    caller: Callable[[str, dict[str, Any]], Any] = mcp_call,
    hook_event_name: str = "UserPromptSubmit",
    subagent_predicate: Callable[[dict[str, Any]], bool] = is_subagent,
) -> str:
    if HOOK_OFF.exists() or subagent_predicate(payload):
        return ""
    if HARNESS == "grok":
        return handle_grok_prepare(payload, caller)
    session = str(pick(payload, "session_id", "sessionId", default="unknown"))
    turn = str(pick(payload, "turn_id", "turnId", default="unknown"))
    prompt = str(pick(payload, "prompt", default=""))
    cwd = str(pick(payload, "cwd", default=os.getcwd()))
    if not prompt:
        return ""
    generation = current_generation(session)
    project = project_scope(cwd)
    state = load_generation_state(session, generation)
    if HARNESS == "codex" and any(
        key in state
        for key in ("last_compaction_fingerprint", "pending_compaction_fingerprint")
    ):
        state.pop("last_compaction_fingerprint", None)
        state.pop("pending_compaction_fingerprint", None)
        atomic_json(generation_path(session), state)
    if not material_topic_change(state, project, prompt):
        log_event("start", "SKIP_TOPIC", session=session, turn=turn, generation=generation)
        return ""
    if HARNESS == "codex" and "accepted_packet" in state:
        state.pop("accepted_packet", None)
        atomic_json(generation_path(session), state)
    t0 = time.monotonic()
    try:
        rows = caller("memory_search", {"query": recall_query(cwd, prompt), "limit": 16, "include_graph": graph_context_needed(prompt)})
        if isinstance(rows, dict):
            rows = rows.get("results") or []
        eligible = rank_rows([row for row in (rows or []) if isinstance(row, dict)], cwd, prompt)
        fresh = unseen_rows(eligible, state)
        ranked = select_recall_rows(fresh, MAX_RECALL_ITEMS)
        context, emitted = format_context_with_emitted_rows(ranked, cwd)
    except Exception:
        log_event("start", "FAIL_OPEN", session=session, turn=turn, reason="service-unavailable", elapsed_ms=int((time.monotonic() - t0) * 1000))
        return ""
    state = update_generation_state(state, project, prompt, emitted)
    if HARNESS == "codex" and context:
        cwd_sha256 = workspace_fingerprint(cwd)
        if cwd_sha256 and valid_codex_context(context):
            state["accepted_packet"] = {
                "version": CODEX_PACKET_VERSION,
                "status": "PREPARED",
                "cwd_sha256": cwd_sha256,
                "context": context,
                "context_sha256": sha256_text(context),
                "selected_count": len(emitted),
                "prepared_at": now_mdt(),
            }
            source_expiry = emitted_source_expiry(emitted)
            if source_expiry:
                state["accepted_packet"]["source_expiry"] = source_expiry
    atomic_json(generation_path(session), state)
    log_event("start", "PASS" if context else "PASS_EMPTY", session=session, turn=turn, generation=generation, count=len(emitted), project=project, elapsed_ms=int((time.monotonic() - t0) * 1000))
    if not context:
        return ""
    return json.dumps({"hookSpecificOutput": {"hookEventName": hook_event_name, "additionalContext": context}}, ensure_ascii=False)


def handle_grok_prepare(
    payload: dict[str, Any],
    caller: Callable[[str, dict[str, Any]], Any] = mcp_call,
) -> str:
    """Recall a bounded plain block without consuming delivery state."""
    if HARNESS != "grok" or HOOK_OFF.exists() or is_grok_subagent(payload):
        return ""
    fields = _grok_prepare_fields(payload)
    if not fields:
        return ""
    session, turn, cwd, prompt, channel = (
        fields["session"], fields["turn"], fields["cwd"],
        fields["prompt"], fields["channel"],
    )
    generation = (
        _rotate_grok_generation(session, payload)
        if is_compaction_prime(payload)
        else _grok_generation_for_prepare(session, payload)
    )
    if not generation:
        log_event("grok-prepare", "SKIP_STALE", session=session, turn=turn)
        return ""
    project = project_scope(cwd)
    initial_state = load_generation_state(session, generation)
    if not material_topic_change(initial_state, project, prompt):
        log_event("grok-prepare", "SKIP_TOPIC", session=session, turn=turn, generation=generation)
        return ""
    t0 = time.monotonic()
    try:
        rows = caller(
            "memory_search",
            {
                "query": recall_query(cwd, prompt),
                "limit": 16,
                "include_graph": graph_context_needed(prompt),
            },
        )
        if isinstance(rows, dict):
            rows = rows.get("results") or []
        candidates = [row for row in (rows or []) if isinstance(row, dict)]
        eligible = rank_rows(candidates, cwd, prompt)
        fresh = unseen_rows(eligible, initial_state)
        ranked = select_recall_rows(fresh, MAX_RECALL_ITEMS)
        context, emitted = format_prepare_context(ranked, cwd)
    except Exception:
        log_event(
            "grok-prepare", "FAIL_OPEN", session=session, turn=turn,
            reason="service-unavailable",
            elapsed_ms=int((time.monotonic() - t0) * 1000),
        )
        return ""

    try:
        with file_lock(session_lock_path(session), nonblocking=False):
            if current_generation(session) != generation:
                log_event("grok-prepare", "SKIP_STALE", session=session, turn=turn)
                return ""
            current = load_generation_state(session, generation)
            # A commit or another prepare may have changed the ledger while
            # the remote search was running. Reapply the current seen filter.
            fresh = unseen_rows(eligible, current)
            ranked = select_recall_rows(fresh, MAX_RECALL_ITEMS)
            context, emitted = format_prepare_context(ranked, cwd)
            pending = {
                "contract_version": GROK_DELIVERY_CONTRACT,
                "status": "PREPARED",
                "session": session,
                "turn": turn,
                "channel": channel,
                "generation": generation,
                "source": _grok_client_field(payload, ("source",), 160) or "client_prompt",
                "prompt_sha256": sha256_text(prompt),
                "context_bytes": len(context.encode("utf-8")),
                "context_sha256": sha256_text(context),
                "selected_ids": _bounded_strings(
                    [row_id(row) for row in emitted], MAX_SEEN_ROWS_PER_GENERATION
                ),
                "selected_text_keys": _bounded_strings(
                    [same_scope_text_key(row) for row in emitted],
                    MAX_SEEN_ROWS_PER_GENERATION,
                ),
                "selected_count": len(emitted),
                "project": project[:160],
                "topic_tokens": sorted(topic_tokens(prompt))[:MAX_TOPIC_TOKENS],
                "created_at": now_mdt(),
            }
            # First client preparation precedes native SessionStart. Persist
            # its empty ledger so passive startup keeps the same generation.
            if not generation_path(session).exists():
                atomic_json(generation_path(session), current)
            atomic_json(grok_pending_path(session, turn, channel), pending)
    except Exception:
        log_event("grok-prepare", "FAIL_OPEN", session=session, turn=turn)
        return ""
    log_event(
        "grok-prepare", "PASS" if context else "PASS_EMPTY",
        session=session, turn=turn, generation=generation,
        count=len(emitted), project=project,
        elapsed_ms=int((time.monotonic() - t0) * 1000),
    )
    return context


def handle_grok_pre_tool(
    payload: dict[str, Any],
    caller: Callable[[str, dict[str, Any]], Any] = mcp_call,
) -> str:
    """Resolve the guarded native prompt and return Grok's PreToolUse envelope."""
    if HARNESS != "grok" or HOOK_OFF.exists():
        return ""
    if is_grok_subagent(payload):
        log_event("grok-pre-tool", "SKIP_SUBAGENT")
        return ""
    transcript = validated_grok_transcript_path(payload)
    if transcript is None:
        log_event("grok-pre-tool", "SKIP_TRANSCRIPT")
        return ""
    prompt = latest_grok_user_prompt(transcript)
    if not prompt:
        log_event("grok-pre-tool", "SKIP_PROMPT")
        return ""
    scoped = dict(payload)
    scoped["prompt"] = prompt
    scoped["delivery_channel"] = "pre_tool"
    context = handle_grok_prepare(scoped, caller)
    if not context:
        return ""
    return json.dumps(
        {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "additionalContext": context,
            }
        },
        ensure_ascii=False,
    )


def _path_under(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def _grok_session_roots(cwd: str) -> list[Path]:
    if not cwd:
        return []
    try:
        workspace = Path(cwd).expanduser().resolve()
    except OSError:
        return []
    if not workspace.is_dir():
        return []
    try:
        raw_root = os.environ.get("BORG_GROK_HISTORY_ROOT")
        if not raw_root:
            return []
        sessions_path = Path(raw_root).expanduser()
        if sessions_path.is_symlink():
            return []
        sessions_root = sessions_path.resolve()
        workspace_path = sessions_root / quote(str(workspace), safe="")
        if workspace_path.is_symlink():
            return []
        workspace_root = workspace_path.resolve()
    except OSError:
        return []
    if not _path_under(workspace_root, sessions_root):
        return []
    return [workspace_root]


def validated_grok_transcript_path(payload: dict[str, Any]) -> Path | None:
    """Resolve only the canonical current-workspace Grok chat history."""
    session = str(pick(payload, "session_id", "sessionId", default="")).strip()
    cwd = str(pick(payload, "cwd", "workspaceRoot", "workspace_root", default=""))
    roots = _grok_session_roots(cwd)
    if not roots or not re.fullmatch(r"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}", session):
        return None
    root = roots[0]
    session_path = root / session
    expected = session_path / "chat_history.jsonl"
    native_updates = session_path / "updates.jsonl"
    try:
        if session_path.is_symlink():
            return None
        session_dir = session_path.resolve()
        if not _path_under(session_dir, root) or not session_dir.is_dir():
            return None
        if expected.is_symlink():
            return None
        resolved = expected.resolve()
        if resolved != expected or not _path_under(resolved, session_dir) or not resolved.is_file():
            return None
    except OSError:
        return None
    supplied = str(pick(payload, "transcript_path", "transcriptPath", default=""))
    if supplied:
        try:
            supplied_path = Path(supplied).expanduser()
        except OSError:
            return None
        if not supplied_path.is_absolute() or supplied_path not in (expected, native_updates):
            return None
        if supplied_path.is_symlink():
            return None
        try:
            supplied_resolved = supplied_path.resolve()
        except OSError:
            return None
        if supplied_resolved != supplied_path or not _path_under(supplied_resolved, session_dir) or not supplied_resolved.is_file():
            return None
    return resolved


def _grok_tail_objects(path: Path) -> list[dict[str, Any]]:
    try:
        size = path.stat().st_size
        with path.open("rb") as handle:
            start = max(0, size - GROK_TAIL_BYTES)
            handle.seek(start)
            raw = handle.read(GROK_TAIL_BYTES)
    except OSError:
        return []
    if start:
        _, separator, raw = raw.partition(b"\n")
        if not separator:
            return []
    objects: list[dict[str, Any]] = []
    for line in raw.splitlines()[-GROK_TAIL_LINES:]:
        try:
            value = json.loads(line.decode("utf-8", errors="ignore"))
        except Exception:
            continue
        if isinstance(value, dict):
            objects.append(value)
    return objects


def latest_grok_user_prompt(path: Path) -> str:
    for obj in reversed(_grok_tail_objects(path)):
        rows, _ = parse_grok_line(obj, 0)
        for _, kind, text in reversed(rows):
            if kind == "user":
                return text
    return ""


def handle_grok_post_tool(
    payload: dict[str, Any],
    caller: Callable[[str, dict[str, Any]], Any] = mcp_call,
) -> str:
    """Commit a successful direct PreToolUse delivery without another recall."""
    if HARNESS != "grok" or HOOK_OFF.exists():
        return ""
    if is_grok_subagent(payload):
        log_event("grok-post-tool", "SKIP_SUBAGENT")
        return ""
    scoped = dict(payload)
    scoped["delivery_channel"] = "pre_tool"
    session = _grok_client_field(scoped, ("session_id", "sessionId"), 160)
    turn = _grok_client_field(
        scoped, ("turn_id", "turnId", "prompt_id", "promptId", "tool_use_id", "toolUseId"), 256
    )
    if session and not turn:
        current = current_generation(session)
        pending_matches = []
        for pending_path in _grok_pending_paths(session):
            pending = _read_object(pending_path)
            if (
                pending.get("session") == session
                and pending.get("channel") == "pre_tool"
                and pending.get("status") == "PREPARED"
                and pending.get("generation") == current
                and pending.get("turn")
            ):
                pending_matches.append(pending)
        if len(pending_matches) == 1:
            pending = pending_matches[0]
            turn = str(pending["turn"])
            if pending.get("context_sha256"):
                scoped["context_sha256"] = pending["context_sha256"]
        else:
            log_event(
                "grok-post-tool", "SKIP_AMBIGUOUS" if pending_matches else "SKIP_MISSING",
                session=session,
            )
            return ""
    if not session or not turn:
        log_event("grok-post-tool", "SKIP_MISSING", session=session or None)
        return ""
    scoped["turn_id"] = turn
    if not pick(scoped, "context_sha256", "contextSha256", default=""):
        pending = _read_object(grok_pending_path(session, turn, "pre_tool"))
        if pending.get("context_sha256"):
            scoped["context_sha256"] = pending["context_sha256"]
    handle_grok_commit(scoped)
    return ""


@dataclass
class TranscriptEvidence:
    records: list[dict[str, str]]
    completed: bool
    digest: str
    parser_overlap: int = 0
    line_count: int = 0
    scanned_line_count: int = 0


@dataclass
class _TranscriptWindow:
    events: list[tuple[int, str, str]]
    last_user: int
    last_assistant: int
    last_complete: int
    line_count: int


def parse_codex_line(obj: dict[str, Any], seq: int, calls: dict[str, str]) -> tuple[list[tuple[int, str, str]], bool, bool]:
    out: list[tuple[int, str, str]] = []
    task_complete = obj.get("type") == "event_msg" and (obj.get("payload") or {}).get("type") == "task_complete"
    if obj.get("type") != "response_item":
        return out, task_complete, False
    payload = obj.get("payload") or {}
    ptype = payload.get("type")
    assistant = False
    if ptype == "message":
        role = str(payload.get("role") or "")
        text = content_text(payload.get("content"))
        if role == "user":
            clean = actual_user_text(text)
            if clean:
                out.append((seq, "user", redact_capture_text(clean)))
        elif role == "assistant" and text.strip():
            assistant = True
    elif ptype in ("function_call", "custom_tool_call"):
        call_id = str(payload.get("call_id") or payload.get("id") or "")
        if call_id:
            calls[call_id] = str(payload.get("name") or "tool")
    elif ptype in ("function_call_output", "custom_tool_call_output"):
        call_id = str(payload.get("call_id") or payload.get("id") or "")
        value = payload.get("output")
        if not isinstance(value, str):
            value = json.dumps(value, ensure_ascii=False, default=str)
        clean = redact_capture_text(value)
        if clean.strip():
            out.append((seq, "tool", f"tool={calls.get(call_id, 'tool')}\n{clean}"))
    return out, task_complete, assistant


def parse_claude_line(obj: dict[str, Any], seq: int) -> tuple[list[tuple[int, str, str]], bool]:
    out: list[tuple[int, str, str]] = []
    otype = str(obj.get("type") or "")
    message = obj.get("message") or {}
    role = str(message.get("role") or otype)
    content = message.get("content")
    assistant = role == "assistant" and bool(content)
    blocks = content if isinstance(content, list) else [{"type": "text", "text": content}] if isinstance(content, str) else []
    for block in blocks:
        if not isinstance(block, dict):
            continue
        btype = str(block.get("type") or "")
        if role == "user" and btype in ("text", "input_text"):
            clean = actual_user_text(str(block.get("text") or ""))
            if clean:
                out.append((seq, "user", redact_capture_text(clean)))
        elif btype == "tool_result":
            value = block.get("content")
            clean = redact_capture_text(content_text(value) if isinstance(value, list) else str(value or ""))
            if clean.strip():
                out.append((seq, "tool", f"tool={block.get('tool_use_id') or 'tool'}\n{clean}"))
    return out, assistant


def grok_user_text(text: str) -> str:
    """Keep the native user task, excluding CLI rules and recalled context."""
    clean = text.strip()
    if clean.startswith("<user_info>"):
        _, closed, clean = clean.partition("</user_info>")
        if not closed:
            return ""
        clean = clean.strip()
        if clean.startswith("<rules>"):
            _, closed, clean = clean.partition("</rules>")
            if not closed:
                return ""
            clean = clean.strip()
    if clean.startswith("<user_query>"):
        if not clean.endswith("</user_query>"):
            return ""
        clean = clean[len("<user_query>"):-len("</user_query>")].strip()
    conductor = clean.startswith(("# Conductor seat rules\n", "# Agent operating rules\n"))
    if conductor:
        boundary = (
            "\n\nUNPROTECTED ACTION POLICY\n"
            "This envelope declares protectedAction:false. Do not send, spend, publish, deploy, merge, "
            "change credentials or accounts, alter DNS, delete unique data, or reboot. "
            "Stop and report BLOCKED_PROTECTED_ACTION if the work requires one of those actions.\n\n"
        )
        _, separator, clean = clean.partition(boundary)
        if not separator:
            return ""
        clean = clean.strip()
        if clean.startswith("<system-reminder>"):
            if not clean.startswith("<system-reminder>\n" + AUTHORITY_NOTICE + "\n"):
                return ""
            _, separator, clean = clean.partition("</system-reminder>")
            if not separator:
                return ""
    return actual_user_text(clean)


def parse_grok_line(obj: dict[str, Any], seq: int) -> tuple[list[tuple[int, str, str]], bool]:
    """Adapt Grok's top-level content without promoting assistant prose."""
    if obj.get("synthetic_reason"):
        return [], False
    role = obj.get("type")
    if role not in ("user", "assistant"):
        return [], False
    content = obj.get("content")
    if content is None:
        message = obj.get("message")
        content = message.get("content") if isinstance(message, dict) else None
    if role == "user":
        if isinstance(content, str):
            content = grok_user_text(content)
        elif isinstance(content, list):
            content = [
                {**block, "text": grok_user_text(str(block.get("text") or ""))}
                if isinstance(block, dict) and block.get("type") in ("text", "input_text") else block
                for block in content
            ]
    return parse_claude_line({"message": {"role": role, "content": content}}, seq)


def _collect_transcript(path: Path, harness: str, start_line: int = 0, end_line: int | None = None) -> _TranscriptWindow:
    events: list[tuple[int, str, str]] = []
    calls: dict[str, str] = {}
    last_user = -1
    last_assistant = -1
    last_complete = -1
    line_count = 0
    with path.open(encoding="utf-8", errors="ignore") as handle:
        for seq, raw in enumerate(handle, 1):
            if (end_line is not None and seq > end_line) or not raw.endswith("\n"):
                break
            line_count = seq
            if seq <= start_line:
                continue
            try:
                obj = json.loads(raw)
            except Exception:
                continue
            if not isinstance(obj, dict):
                continue
            if harness == "codex":
                rows, complete, assistant = parse_codex_line(obj, seq, calls)
                if complete:
                    last_complete = seq
            elif harness == "grok":
                if obj.get("type") == "user" and not obj.get("synthetic_reason"):
                    last_user = seq
                rows, assistant = parse_grok_line(obj, seq)
            else:
                rows, assistant = parse_claude_line(obj, seq)
            for row in rows:
                events.append(row)
                if row[1] == "user":
                    last_user = seq
            if assistant:
                last_assistant = seq
    return _TranscriptWindow(events, last_user, last_assistant, last_complete, line_count)


def _records_json(records: list[dict[str, str]]) -> str:
    return json.dumps(records, ensure_ascii=False, separators=(",", ":"))


def _render_transcript(
    window: _TranscriptWindow,
    events: list[tuple[int, str, str]],
    harness: str,
    assistant_completed: bool = False,
) -> TranscriptEvidence:
    selected = events[-MAX_RECORDS:]
    records: list[dict[str, str]] = []
    chars = 0
    user_i = 0
    tool_i = 0
    for _, kind, value in reversed(selected):
        text = redact_capture_text(unicodedata.normalize("NFC", str(value)))
        if (
            not text.strip()
            or len(text) > 5000
            or sensitive_reason(text)
            or chars + len(text) > MAX_EVIDENCE_CHARS
        ):
            continue
        if kind == "user":
            ref = f"U{user_i + 1}"
        else:
            ref = f"T{tool_i + 1}"
        candidate = {"ref": ref, "kind": kind, "text": text}
        try:
            candidate_bytes = len(
                _records_json([candidate] + list(reversed(records))).encode("utf-8")
            )
        except UnicodeEncodeError:
            continue
        if candidate_bytes > MAX_RECORD_JSON_BYTES:
            continue
        records.append(candidate)
        chars += len(text)
        if kind == "user":
            user_i += 1
        else:
            tool_i += 1
    records.reverse()
    digest = sha256_text(_records_json(records))
    if harness == "codex":
        completed = assistant_completed or (
            window.last_complete > window.last_user >= 0
            and window.last_assistant > window.last_user
        )
    else:
        completed = assistant_completed or (
            window.last_assistant > window.last_user >= 0
        )
    overlap = window.last_user if window.last_user >= 0 else (
        events[-1][0] if events else 0
    )
    return TranscriptEvidence(records, completed, digest, overlap, window.line_count)


def parse_transcript(path: Path, harness: str, assistant_completed: bool = False) -> TranscriptEvidence:
    window = _collect_transcript(path, harness)
    return _render_transcript(window, window.events, harness, assistant_completed)


def parse_incremental_transcript(
    path: Path,
    harness: str,
    prior_high_water: int,
    parser_overlap: int,
    assistant_completed: bool = False,
    end_line: int | None = None,
) -> TranscriptEvidence:
    """Render a complete prefix; never commit across budget-omitted records.

    A source line is indivisible with the existing line cursor. Oversized
    multi-record lines fail closed and remain in the transcript for recovery.
    """
    start_line = max(0, parser_overlap - 1) if prior_high_water else 0
    window = _collect_transcript(path, harness, start_line, end_line)
    events = [row for row in window.events if row[0] > prior_high_water]
    overlap = [row for row in window.events if prior_high_water and row[0] == parser_overlap]
    selected = list(overlap)
    high_water = window.line_count
    index = 0
    while index < len(events):
        seq = events[index][0]
        group = []
        while index < len(events) and events[index][0] == seq:
            group.append(events[index])
            index += 1
        candidate = selected + group
        eligible = [row for row in candidate
                    if (text := redact_capture_text(unicodedata.normalize("NFC", str(row[2])))).strip()
                    and not sensitive_reason(text)]
        rendered = _render_transcript(window, candidate, harness, assistant_completed)
        if len(candidate) > MAX_RECORDS or len(rendered.records) != len(eligible):
            if not any(row[0] > prior_high_water for row in selected):
                # Context overlap must not prevent a source line fitting alone.
                if overlap:
                    selected = []
                    overlap = []
                    index -= len(group)
                    continue
                raise ValueError("capture source line exceeds evidence budget")
            high_water = seq - 1
            break
        selected = candidate
    evidence = _render_transcript(window, selected, harness, assistant_completed)
    evidence.line_count = high_water
    evidence.scanned_line_count = window.line_count
    users = [row[0] for row in selected if row[1] == "user" and row[0] <= high_water]
    evidence.parser_overlap = users[-1] if users else 0
    return evidence


def capture_receipt(digest: str, request: dict[str, Any] | None = None) -> Path:
    route = frozen_routing(request)
    return state_root(route["machine"], route["harness"]) / "capture" / f"{digest}.json"


def request_path(digest: str, request: dict[str, Any] | None = None) -> Path:
    route = frozen_routing(request)
    return state_root(route["machine"], route["harness"]) / "requests" / f"{digest}.json"


def capture_key(request: dict[str, Any]) -> str:
    """Keep two source events with identical evidence in separate queue slots."""
    route = frozen_routing(request)
    return sha256_text(json.dumps([
        route["endpoint"], route["token_file"], request.get("source_system") or route["harness"],
        request.get("source_event_id") or request.get("session"),
        request.get("source_version") or request.get("digest"),
    ], ensure_ascii=False, separators=(",", ":")))


def capture_cursor_path(
    session: str, machine: str | None = None, harness: str | None = None
) -> Path:
    return state_root(machine, harness) / "cursors" / f"{safe_component(session)}.json"


def capture_reservation_path(
    session: str, machine: str | None = None, harness: str | None = None
) -> Path:
    return state_root(machine, harness) / "reservations" / f"{safe_component(session)}.json"


def _bounded_position(value: Any) -> int:
    try:
        return min(MAX_CURSOR_POSITION, max(0, int(value or 0)))
    except (TypeError, ValueError):
        return 0


def load_capture_cursor(
    session: str, machine: str | None = None, harness: str | None = None
) -> dict[str, Any]:
    stored = _read_object(capture_cursor_path(session, machine, harness))
    source_version = str(stored.get("source_version") or "")
    if not re.fullmatch(r"[0-9a-f]{64}", source_version):
        source_version = ""
    high_water = _bounded_position(stored.get("high_water"))
    parser_overlap = min(
        high_water,
        _bounded_position(stored.get("parser_overlap")),
    )
    return {
        "high_water": high_water,
        "source_version": source_version,
        "parser_overlap": parser_overlap,
    }


def load_capture_reservation(
    session: str, machine: str | None = None, harness: str | None = None
) -> dict[str, Any]:
    stored = _read_object(capture_reservation_path(session, machine, harness))
    return {
        "high_water": _bounded_position(stored.get("high_water")),
        "parser_overlap": _bounded_position(stored.get("parser_overlap")),
        "source_version": str(stored.get("source_version") or "")[:64],
        "digest": str(stored.get("digest") or "")[:64],
        "request_digest": str(stored.get("request_digest") or "")[:64],
        "source_path": str(stored.get("source_path") or "")[:2048],
        "session": str(stored.get("session") or "")[:160],
    }


def _transcript_line_count(path: Path) -> int:
    try:
        with path.open(encoding="utf-8", errors="ignore") as handle:
            count = sum(1 for _ in handle)
    except OSError:
        return 0
    return _bounded_position(count)


def _advance_capture_cursor(request: dict[str, Any]) -> bool:
    update = request.get("_capture_cursor")
    session = str(request.get("session") or "")
    if not isinstance(update, dict) or not session:
        return True
    source_version = str(update.get("source_version") or "")
    if not re.fullmatch(r"[0-9a-f]{64}", source_version):
        return False
    route = frozen_routing(request)
    cursor_path = capture_cursor_path(session, route["machine"], route["harness"])
    try:
        with file_lock(session_lock_path(session, route["machine"], route["harness"]), nonblocking=False):
            current = load_capture_cursor(session, route["machine"], route["harness"])
            high_water = _bounded_position(update.get("high_water"))
            if cursor_path.exists() and high_water < current["high_water"]:
                durable_existing(cursor_path)
                return True
            durable_json(
                cursor_path,
                {
                    "high_water": high_water,
                    "source_version": source_version,
                    "parser_overlap": min(
                        high_water,
                        _bounded_position(update.get("parser_overlap")),
                    ),
                },
            )
            reservation_path = capture_reservation_path(
                session, route["machine"], route["harness"]
            )
            reservation = _read_object(reservation_path)
            if (
                reservation.get("source_version") == source_version
                and _bounded_position(reservation.get("high_water")) <= high_water
            ):
                durable_unlink(reservation_path, cursor_path)
        return True
    except Exception:
        return False


def _source_system() -> str:
    value = HARNESS.strip().lower()
    return value if value in {"codex", "claude", "grok"} else "codex"


def _clean_source_identity(value: Any) -> str:
    if value in (None, ""):
        return ""
    text = unicodedata.normalize("NFC", str(value)).strip()
    if not text or any(unicodedata.category(char).startswith("C") for char in text):
        return ""
    return text[:512]


def source_identity(payload: dict[str, Any], session: str) -> tuple[str, str]:
    """Return native conversation identity, or a labelled session fallback."""
    for key in (
        "conversation_id", "conversationId", "conversation_uuid", "conversationUuid",
        "native_conversation_id", "nativeConversationId", "thread_id", "threadId",
        "chat_id", "chatId",
    ):
        value = _clean_source_identity(payload.get(key))
        if value:
            return value, ""
    return _clean_source_identity(session) or "unknown", "legacy_session"


LIFECYCLE_FIELDS = (
    "records_json", "session", "cwd", "machine", "harness", "digest", "completed",
    "source_system", "source_event_id", "source_version", "identity_quality",
)
CAPTURE_ACCEPTED = {"PASS", "PASS_EMPTY", "SKIP_DUP"}
HERMES_CAPTURE_REQUIRED = {
    "records_json", "session", "cwd", "machine", "harness", "digest", "completed",
    "source_system", "source_event_id", "source_version",
}
HERMES_CAPTURE_ALLOWED = HERMES_CAPTURE_REQUIRED | {"identity_quality", "_routing"}


def _lifecycle_request(request: dict[str, Any]) -> dict[str, Any]:
    arguments = {
        key: request[key]
        for key in LIFECYCLE_FIELDS
        if key in request
    }
    update = request.get("_capture_cursor")
    if isinstance(update, dict) and "prior_high_water" in update:
        start, end = update["prior_high_water"], update.get("high_water")
        if (type(start) is not int or type(end) is not int
                or not 0 <= start < end <= MAX_CURSOR_POSITION):
            raise ValueError("invalid capture source range")
        expected = sha256_text(f"{request.get('digest')}:{start}:{end}")
        if (request.get("source_version") != expected
                or update.get("source_version") != expected):
            raise ValueError("capture source range version mismatch")
        # Transport projection only: retained immutable envelopes stay intact.
        arguments.update(source_range_start=start, source_range_end=end)
    return arguments


def _valid_hermes_records(records_json: Any) -> bool:
    """Validate the exact record shape accepted by lifecycle capture."""
    if not isinstance(records_json, str):
        return False
    if len(records_json.encode("utf-8", errors="replace")) > MAX_RECORD_JSON_BYTES:
        return False
    try:
        records = json.loads(records_json)
    except Exception:
        return False
    if not isinstance(records, list) or len(records) > MAX_RECORDS:
        return False
    refs: set[str] = set()
    chars = 0
    for row in records:
        if not isinstance(row, dict) or set(row) != {"ref", "kind", "text"}:
            return False
        ref, kind, text = row.get("ref"), row.get("kind"), row.get("text")
        if (
            not isinstance(ref, str)
            or not isinstance(kind, str)
            or not isinstance(text, str)
            or not re.fullmatch(r"[UT]\d{1,3}", ref)
            or ref in refs
            or kind not in {"user", "tool"}
            or (ref.startswith("U") and kind != "user")
            or (ref.startswith("T") and kind != "tool")
            or not text.strip()
            or len(text) > 5000
            or sensitive_reason(text)
        ):
            return False
        chars += len(text)
        if chars > MAX_EVIDENCE_CHARS:
            return False
        refs.add(ref)
    return True


def validate_hermes_capture_request(request: Any) -> dict[str, Any] | None:
    """Return a canonical, transcript-free Hermes envelope or refuse it."""
    if not isinstance(request, dict):
        return None
    if set(request) - HERMES_CAPTURE_ALLOWED or not HERMES_CAPTURE_REQUIRED <= set(request):
        return None
    if request.get("harness") != "hermes" or request.get("source_system") != "hermes":
        return None
    if request.get("completed") is not True or not _valid_hermes_records(request.get("records_json")):
        return None
    digest = request.get("digest")
    source_version = request.get("source_version")
    if (
        not isinstance(digest, str)
        or not re.fullmatch(r"[0-9a-f]{64}", digest)
        or source_version != digest
        or sha256_text(request["records_json"]) != digest
    ):
        return None
    limits = {
        "session": 160,
        "cwd": 2048,
        "machine": 160,
        "harness": 32,
        "source_system": 32,
        "source_event_id": 240,
        "source_version": 64,
    }
    for key, limit in limits.items():
        value = request.get(key)
        if (
            not isinstance(value, str)
            or not value
            or len(value.encode("utf-8", errors="replace")) > limit
            or any(unicodedata.category(char).startswith("C") for char in value)
        ):
            return None
    if request.get("identity_quality", "") not in {"", "legacy_session"}:
        return None

    nested = request.get("_routing")
    if nested is not None and not isinstance(nested, dict):
        return None
    route = frozen_routing(request)
    if (
        route["harness"] != "hermes"
        or route["machine"] != request["machine"]
        or not route["token_file"]
        or not route["endpoint"]
    ):
        return None
    if isinstance(nested, dict):
        for key in ("machine", "harness"):
            if key in nested and nested[key] != route[key]:
                return None
        for key in ("token_file", "endpoint"):
            if key in nested and not isinstance(nested[key], str):
                return None

    canonical = _lifecycle_request(request)
    canonical["_routing"] = route
    return canonical


def _spawn_capture_worker(path: Path, machine: str, harness: str) -> bool:
    """Start the existing detached worker without risking its durable request."""
    try:
        subprocess.Popen(
            [str(Path(__file__).resolve()), "worker", str(path)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            start_new_session=True,
            env={**os.environ, "MEM0_MACHINE": machine, "MEM0_HARNESS": harness},
        )
        return True
    except Exception:
        return False


def queue_capture_request(request: Any) -> str:
    """Persist one validated Hermes envelope before returning to its caller."""
    if HOOK_OFF.exists() or os.environ.get("MEM0_CAPTURE_SKIP") == "1":
        return "KILL_SWITCH"
    canonical = validate_hermes_capture_request(request)
    if canonical is None:
        return "INVALID_REQUEST"
    try:
        request_digest = capture_key(canonical)
        receipt = capture_receipt(request_digest, canonical)
        if receipt.exists() and _read_object(receipt).get("status") in CAPTURE_ACCEPTED:
            return "SKIP_DUP"
        path = request_path(request_digest, canonical)
        if path.exists():
            return "SKIP_DUP"
        durable_json(path, canonical)
        route = canonical["_routing"]
        _spawn_capture_worker(path, route["machine"], route["harness"])
        return "QUEUED"
    except Exception:
        return "FAIL_OPEN"


def process_capture_request(
    request: dict[str, Any],
    caller: Callable[[str, dict[str, Any]], Any] = mcp_call,
    deadline: float | None = None,
) -> str:
    if HOOK_OFF.exists() or os.environ.get("MEM0_CAPTURE_SKIP") == "1":
        return "KILL_SWITCH"
    update = request.get("_capture_cursor")
    if isinstance(update, dict) and "prior_high_water" in update:
        route = frozen_routing(request)
        current = load_capture_cursor(str(request.get("session") or ""), route["machine"], route["harness"])
        if current["high_water"] < _bounded_position(update["prior_high_water"]):
            return "DEFERRED"
    digest = str(request.get("digest") or "")
    receipt = capture_receipt(capture_key(request), request)
    if receipt.exists():
        prior = _read_object(receipt)
        if str(prior.get("status") or "") in CAPTURE_ACCEPTED:
            durable_existing(receipt)
            if not _advance_capture_cursor(request):
                return "CONTINUATION_PENDING"
            return "SKIP_DUP"
    try:
        route = frozen_routing(request)
        if deadline is not None:
            route["_deadline"] = deadline
        if caller is mcp_call:
            result = caller("memory_lifecycle_capture", _lifecycle_request(request), route)
        else:
            result = caller("memory_lifecycle_capture", _lifecycle_request(request))
        result = result if isinstance(result, dict) else {}
        status = str(result.get("status") or "FAIL_OPEN")
    except Exception:
        status = "FAIL_OPEN"
    if status in CAPTURE_ACCEPTED:
        durable_json(receipt, {"status": status, "digest": digest, "session": request.get("session"), "at": now_mdt()})
    if status in CAPTURE_ACCEPTED:
        if not _advance_capture_cursor(request):
            return "CONTINUATION_PENDING"
    log_event("capture", status, session=request.get("session"), digest=digest[:16])
    return status


def _continue_capture(request: dict[str, Any]) -> bool:
    update = request.get("_capture_cursor")
    if not isinstance(update, dict) or "scan_end" not in update:
        return True
    target = _bounded_position(update["scan_end"])
    route = frozen_routing(request)
    session = str(request.get("session") or "")
    current = load_capture_cursor(session, route["machine"], route["harness"])
    if current["high_water"] < _bounded_position(update.get("high_water")):
        return False
    if target <= _bounded_position(update.get("high_water")):
        return True
    try:
        with file_lock(session_lock_path(session, route["machine"], route["harness"]), nonblocking=True):
            cursor = load_capture_cursor(session, route["machine"], route["harness"])
            reservation = load_capture_reservation(session, route["machine"], route["harness"])
            if cursor["high_water"] >= target:
                return True
            if reservation["high_water"] > cursor["high_water"]:
                pending = request_path(reservation["request_digest"], request)
                durable_existing(pending)
                durable_existing(capture_reservation_path(session, route["machine"], route["harness"]))
                return True
            evidence = parse_incremental_transcript(
                Path(request["source_path"]), route["harness"], cursor["high_water"],
                cursor["parser_overlap"], bool(request.get("completed")), target,
            )
            if evidence.line_count <= cursor["high_water"] or evidence.scanned_line_count != target:
                return False
            next_request = dict(request)
            next_request.update(records_json=_records_json(evidence.records), digest=evidence.digest)
            next_request["source_version"] = sha256_text(
                f"{evidence.digest}:{cursor['high_water']}:{evidence.line_count}"
            )
            next_request["_capture_cursor"] = {
                "prior_high_water": cursor["high_water"], "high_water": evidence.line_count,
                "parser_overlap": evidence.parser_overlap, "scan_end": target,
                "source_version": next_request["source_version"],
            }
            key = capture_key(next_request)
            path = request_path(key, next_request)
            if not path.exists():
                durable_json(path, next_request)
            else:
                durable_existing(path)
            durable_json(capture_reservation_path(session, route["machine"], route["harness"]),
                        _capture_reservation_from_request(next_request, key))
            return True
    except Exception:
        return False


def _run_request_path(path: Path, deadline: float | None = None) -> str:
    lock_path = path.with_suffix(".lock")
    ensure_private_dir(lock_path.parent)
    handle = None
    try:
        handle = open(lock_path, "a+", encoding="utf-8")
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        if handle:
            handle.close()
        return "LOCKED"
    try:
        durable_existing(path)
        request = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(request, dict):
            return "FAIL_OPEN"
        status = process_capture_request(request, deadline=deadline)
        if status in CAPTURE_ACCEPTED:
            if not _continue_capture(request):
                return "CONTINUATION_PENDING"
            durable_unlink(path, capture_receipt(capture_key(request), request))
        return status
    except Exception:
        return "FAIL_OPEN"
    finally:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
            handle.close()
            # Never unlink a flock inode: another worker may already hold it.
        except Exception:
            pass


def run_worker(path: Path) -> int:
    try:
        with file_lock(STATE / safe_component(MACHINE) / "replay.lock", nonblocking=True):
            if not _capture_cooling_down():
                status = _run_request_path(path)
                if status == "BUSY":
                    _capture_backoff()
    except (BlockingIOError, OSError):
        pass  # Durable request is supplied to the existing scheduled replay.
    return 0


def _capture_cooling_down() -> bool:
    state = _read_object(STATE / safe_component(MACHINE) / "capture-backoff.json")
    try:
        return 0 < float(state.get("retry_at", 0)) - time.time() <= 30
    except (ValueError, TypeError):
        return False


def _capture_backoff() -> None:
    # Stable host jitter avoids all hosts immediately retrying the shared door.
    delay = 5 + int(sha256_text(MACHINE)[:4], 16) % 11
    durable_json(STATE / safe_component(MACHINE) / "capture-backoff.json",
                {"retry_at": time.time() + delay})


def _replay_limits() -> tuple[int, float]:
    try:
        item_cap = int(os.environ.get("MEM0_REPLAY_ITEM_CAP", REPLAY_ITEM_CAP))
    except (TypeError, ValueError):
        item_cap = REPLAY_ITEM_CAP
    try:
        wall_seconds = float(os.environ.get("MEM0_REPLAY_WALL_SECONDS", REPLAY_WALL_SECONDS))
    except (TypeError, ValueError):
        wall_seconds = REPLAY_WALL_SECONDS
    return max(1, min(REPLAY_ITEM_CAP, item_cap)), max(0.01, min(REPLAY_WALL_SECONDS, wall_seconds))


def replay_requests() -> int:
    """Retry each frozen retained request at most once per bounded pass."""
    item_cap, wall_seconds = _replay_limits()
    if _capture_cooling_down():
        return 0
    global_lock = STATE / safe_component(MACHINE) / "replay.lock"
    try:
        lock_context = file_lock(global_lock, nonblocking=True)
        handle = lock_context.__enter__()
    except (BlockingIOError, OSError):
        return 0
    processed = 0
    started = time.monotonic()
    try:
        paths: list[Path] = []
        for path in STATE.glob(f"{safe_component(MACHINE)}/*/requests/*.json"):
            try:
                if path.is_file():
                    paths.append(path)
            except OSError:
                continue
        # A detached worker may finish between discovery and sorting.
        dated = []
        for path in paths:
            try:
                dated.append((path.stat().st_mtime_ns, str(path), path))
            except OSError:
                continue
        paths = [row[2] for row in sorted(dated)]
        for path in paths:
            if processed >= item_cap or time.monotonic() - started >= wall_seconds:
                break
            status = _run_request_path(path, started + wall_seconds)
            if status not in CAPTURE_ACCEPTED and status != "LOCKED":
                # Rotate attempted failures behind untouched requests. Frozen
                # envelope bytes stay unchanged; one poison item cannot starve
                # later turns under the bounded replay item cap.
                try:
                    os.utime(path, None)
                except OSError:
                    pass
            processed += 1
            if status == "BUSY":
                _capture_backoff()
                break
    finally:
        lock_context.__exit__(None, None, None)
    log_event("capture-replay", "PASS", count=processed)
    return processed


def _retained_capture_request(
    session: str,
    source_path: str,
    high_water: int,
    machine: str,
    harness: str,
) -> tuple[Path, dict[str, Any]] | None:
    directory = state_root(machine, harness) / "requests"
    try:
        paths = sorted(directory.glob("*.json"), key=lambda path: (path.stat().st_mtime_ns, str(path)))
    except OSError:
        return None
    for path in paths:
        request = _read_object(path)
        update = request.get("_capture_cursor")
        if (
            request.get("session") != session
            or request.get("source_path") != source_path
            or not isinstance(update, dict)
            or _bounded_position(update.get("high_water")) < high_water
            or not request.get("records_json")
        ):
            continue
        return path, request
    return None


def _capture_reservation_from_request(
    request: dict[str, Any], request_digest: str
) -> dict[str, Any]:
    update = request.get("_capture_cursor") if isinstance(request.get("_capture_cursor"), dict) else {}
    return {
        "session": str(request.get("session") or "")[:160],
        "source_path": str(request.get("source_path") or "")[:2048],
        "source_version": str(update.get("source_version") or "")[:64],
        "digest": str(request.get("digest") or "")[:64],
        "request_digest": request_digest[:64],
        "high_water": _bounded_position(update.get("high_water")),
        "parser_overlap": _bounded_position(update.get("parser_overlap")),
        "created_at": now_mdt(),
    }


def handle_end(payload: dict[str, Any]) -> str:
    event_name = str(pick(payload, "hook_event_name", "hookEventName", default="Stop"))
    stop_output = "{}" if event_name.lower() == "stop" else ""
    if HOOK_OFF.exists() or os.environ.get("MEM0_CAPTURE_SKIP") == "1" or is_subagent(payload):
        return stop_output
    session = str(pick(payload, "session_id", "sessionId", default="unknown"))
    turn = str(pick(payload, "turn_id", "turnId", default="session-end"))
    transcript = str(pick(payload, "transcript_path", "transcriptPath", default=""))
    cwd = str(pick(payload, "cwd", default=""))
    if HARNESS == "grok":
        canonical = validated_grok_transcript_path(payload)
        if canonical is None:
            log_event("end-enqueue", "SKIP_TRANSCRIPT", session=session, turn=turn, event_name=event_name)
            return stop_output
        transcript = str(canonical)
    if not transcript or not Path(transcript).is_file():
        log_event("end-enqueue", "FAIL_OPEN", session=session, turn=turn, event_name=event_name, reason="missing-transcript")
        return stop_output
    transcript_path = Path(transcript)
    high_water = _transcript_line_count(transcript_path)
    machine, harness = MACHINE, HARNESS
    lock_path = session_lock_path(session, machine, harness)
    try:
        lock_context = file_lock(lock_path, nonblocking=True)
        lock_context.__enter__()
    except (BlockingIOError, OSError):
        log_event("end-enqueue", "SKIP_BUSY", session=session, turn=turn, event_name=event_name)
        return stop_output
    try:
        cursor = load_capture_cursor(session, machine, harness)
        reservation = load_capture_reservation(session, machine, harness)
        frontier_high = max(cursor["high_water"], reservation["high_water"])
        frontier_overlap = (
            reservation["parser_overlap"]
            if reservation["high_water"] >= cursor["high_water"]
            else cursor["parser_overlap"]
        )
        if high_water <= frontier_high:
            if high_water <= cursor["high_water"]:
                log_event("end-enqueue", "SKIP_NO_NEW", session=session, turn=turn, event_name=event_name)
                return stop_output
            retained = _retained_capture_request(
                session, str(transcript_path), high_water, machine, harness
            )
            if retained:
                path, request = retained
                durable_existing(path)
                request_digest = capture_key(request)
                if not reservation.get("request_digest") or reservation.get("request_digest") == request_digest:
                    durable_json(
                        capture_reservation_path(session, machine, harness),
                        _capture_reservation_from_request(request, request_digest),
                    )
                    _spawn_capture_worker(path, machine, harness)
                    return stop_output
            log_event("end-enqueue", "SKIP_NO_NEW", session=session, turn=turn, event_name=event_name)
            return stop_output

        retained = _retained_capture_request(
            session, str(transcript_path), frontier_high + 1, machine, harness
        )
        if retained:
            path, request = retained
            durable_existing(path)
            request_digest = capture_key(request)
            durable_json(
                capture_reservation_path(session, machine, harness),
                _capture_reservation_from_request(request, request_digest),
            )
        else:
            try:
                evidence = parse_incremental_transcript(
                    transcript_path,
                    harness,
                    frontier_high,
                    frontier_overlap,
                    bool(pick(payload, "last_assistant_message", "lastAssistantMessage", default="")),
                )
            except Exception:
                log_event("end-enqueue", "FAIL_OPEN", session=session, turn=turn, event_name=event_name, reason="transcript-parse")
                return stop_output
            if not evidence.completed:
                log_event("end-enqueue", "SKIP_INTERRUPTED", session=session, turn=turn, event_name=event_name, digest=evidence.digest[:16])
                return stop_output
            records_json = _records_json(evidence.records)
            captured_high_water = evidence.line_count
            source_version = sha256_text(f"{evidence.digest}:{frontier_high}:{captured_high_water}")
            source_event_id, identity_quality = source_identity(payload, session)
            request = {
                "records_json": records_json,
                "session": session, "cwd": cwd, "machine": machine, "harness": harness,
                "digest": evidence.digest, "completed": True,
                "source_system": harness if harness in {"codex", "claude", "grok"} else "codex",
                "source_event_id": source_event_id,
                "source_version": source_version,
                "source_path": str(transcript_path)[:2048],
                "_routing": {
                    "machine": machine,
                    "harness": harness,
                    "token_file": str(TOKEN_FILE)[:2048],
                    "endpoint": endpoint()[:2048],
                },
                "_capture_cursor": {
                    "prior_high_water": frontier_high,
                    "high_water": captured_high_water,
                    "scan_end": evidence.scanned_line_count,
                    "source_version": source_version,
                    "parser_overlap": evidence.parser_overlap,
                },
            }
            if identity_quality:
                request["identity_quality"] = identity_quality
            request_digest = capture_key(request)
            path = request_path(request_digest, request)
            # Request first, reservation second. A crash between these writes
            # is recovered from the exact retained request on the next event.
            durable_json(path, request)
            durable_json(
                capture_reservation_path(session, machine, harness),
                _capture_reservation_from_request(request, request_digest),
            )
        if _spawn_capture_worker(path, machine, harness):
            log_event("end-enqueue", "PASS", session=session, turn=turn, event_name=event_name, digest=str(request.get("digest") or "")[:16])
        else:
            log_event("end-enqueue", "FAIL_OPEN", session=session, turn=turn, event_name=event_name, reason="spawn-failed")
    finally:
        lock_context.__exit__(None, None, None)
    return stop_output


def main(argv: list[str]) -> int:
    mode = argv[1] if len(argv) > 1 else "start"
    if mode == "worker":
        return run_worker(Path(argv[2])) if len(argv) > 2 else 0
    payload = load_payload()
    if mode == "prime":
        output = handle_prime(payload)
    elif mode == "end":
        output = handle_end(payload)
    elif mode == "enqueue":
        output = json.dumps({"status": queue_capture_request(payload)}, separators=(",", ":"))
    elif mode == "prepare":
        output = handle_grok_prepare(payload)
    elif mode == "commit":
        output = handle_grok_commit(payload)
    elif mode in {"pre_tool", "pre-tool", "pretool"}:
        output = handle_grok_pre_tool(payload)
    elif mode == "replay":
        replay_requests()
        output = ""
    elif mode in {"post_tool", "post-tool", "posttool"}:
        output = handle_grok_post_tool(payload)
    else:
        output = handle_start(payload)
    if output:
        emitted = output if output.endswith("\n") else output + "\n"
        sys.stdout.write(emitted)
        sys.stdout.flush()
        if mode in {"start", "prime"}:
            commit_codex_packet(payload, output, mode)
        session = str(pick(payload, "session_id", "sessionId", default="unknown"))
        log_event(
            "stdout", "PASS", session=session, mode=mode,
            output_bytes=len(emitted.encode("utf-8")),
            output_sha256=sha256_text(emitted),
        )
    return 0


def run_main(argv: list[str]) -> int:
    try:
        return main(argv)
    except Exception as error:
        log_event("outer", "FAIL_OPEN", reason=type(error).__name__)
        return 0


if __name__ == "__main__":
    raise SystemExit(run_main(sys.argv))

#!/usr/bin/env python3
"""Generalized remote thread-mine driver over configured SSH.
State, lock, and log live in BORG_HOME; extraction runs remotely.

Usage: mem0-remote-driver --ssh worker.example --tag remote [--kind remote-thread]
       [--extra-env K=V ...]
"""

import os

os.environ["MEM0_TELEMETRY"] = "false"

import argparse
import atexit
import importlib.machinery
import json
import shlex
import subprocess
import time
from pathlib import Path
from borg_config import CONFIG, BorgConfigError

BASE = Path(__file__).resolve().parent.parent
CTL = importlib.machinery.SourceFileLoader("mem0ctl_mod", str(BASE / "bin/mem0ctl")).load_module()
RECEIVE = str(BASE / "bin/mem0-receive-facts")

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--ssh", required=True, help="ssh alias or user@host")
    ap.add_argument("--tag", required=True, help="short configured remote name")
    ap.add_argument("--kind", default="remote-thread")
    ap.add_argument("--miner-command", default=os.environ.get("BORG_REMOTE_MINER_COMMAND"))
    ap.add_argument("--model-probe-command", default=os.environ.get("BORG_REMOTE_MODEL_PROBE_COMMAND"))
    ap.add_argument("--model-marker", default=os.environ.get("BORG_REMOTE_MODEL_MARKER"))
    ap.add_argument("--model-ensure-command", default=os.environ.get("BORG_REMOTE_MODEL_ENSURE_COMMAND"))
    ap.add_argument("--pace", type=float, default=1.5)
    ap.add_argument("--extra-env", action="append", default=[], metavar="K=V",
                    help="extra env for the remote miner, repeatable "
                         "(e.g. MINER_URL_LLAMA=http://127.0.0.1:11435 to keep "
                         "the fallback off a do-not-touch Ollama)")
    args = ap.parse_args()
    if not args.miner_command or not args.model_probe_command or not args.model_marker:
        raise BorgConfigError("remote mining requires an explicit miner command, model probe command, and model marker")

    SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", args.ssh]
    MINER_ENV = f"MINER_KIND={args.kind} MINER_PREFIX=thr-{args.tag}-"
    for kv in args.extra_env:
        MINER_ENV += " " + shlex.quote(kv)
    MINER = f"{MINER_ENV} {args.miner_command}"
    state_f = BASE / f"data/{args.tag}-state.json"
    log_f = BASE / f"data/{args.tag}-ingest.log"
    lock_f = BASE / f"data/{args.tag}.lock"

    def log(msg):
        with open(log_f, "a") as f:
            f.write(f"{CTL.now_mdt()} {msg}\n")
        print(msg, flush=True)

    if lock_f.exists():
        try:
            os.kill(int(lock_f.read_text()), 0)
            print("already running; exiting")
            return
        except (ProcessLookupError, ValueError):
            pass
    lock_f.write_text(str(os.getpid()))
    atexit.register(lambda: lock_f.unlink(missing_ok=True))

    try:
        r = subprocess.run(SSH + [args.model_ensure_command], capture_output=True, text=True, timeout=30) if args.model_ensure_command else None
        if r and (r.stdout or ""):
            log("REMOTE MODEL ENSURE COMMAND COMPLETED")
    except Exception:
        pass

    ready = False
    for _ in range(90):  # up to 45 min for a model pull
        r = subprocess.run(SSH + [args.model_probe_command], capture_output=True, text=True, timeout=30)
        out = r.stdout or ""
        if args.model_marker in out:
            log(f"MODEL READY on {args.tag}")
            ready = True
            break
        time.sleep(30)
    if not ready:
        log("MODEL NOT READY — aborting; rerun later")
        return

    r = subprocess.run(SSH + [MINER + " --list"], capture_output=True, text=True, timeout=300)
    files = []
    for line in (r.stdout or "").splitlines():
        try:
            mtime, path = line.split("\t", 1)
            files.append((int(mtime), path))
        except ValueError:
            pass
    files.sort(reverse=True)
    st = json.loads(state_f.read_text()) if state_f.exists() else {"done": {}}
    todo = [(m, p) for m, p in files if p not in st["done"]]
    log(f"RUN-START {args.tag} threads={len(files)} todo={len(todo)}")

    total = 0
    for i, (_, path) in enumerate(todo, 1):
        t0 = time.time()
        try:
            r = subprocess.run(SSH + [MINER + f" --one '{path}'"], capture_output=True, text=True, timeout=480)
            rows = [ln for ln in (r.stdout or "").splitlines() if ln.strip().startswith("{")]
            if rows:
                rec = subprocess.run([RECEIVE], input="\n".join(rows), capture_output=True, text=True, timeout=300)
                summary = (rec.stdout or "").strip()
            else:
                summary = "RECEIVED stored=0"
            kept = int(summary.split("stored=")[1].split()[0]) if "stored=" in summary else 0
            total += kept
            st["done"][path] = {"kept": kept, "at": CTL.now_mdt()}
            status = "ok"
        except subprocess.TimeoutExpired:
            st["done"][path] = {"kept": 0, "status": "timeout"}
            kept, status = 0, "timeout"
        except Exception as e:
            st["done"][path] = {"kept": 0, "status": f"error:{type(e).__name__}"}
            kept, status = 0, f"error:{type(e).__name__}"
        state_f.write_text(json.dumps(st))
        log(f"[{i}/{len(todo)}] {status} kept={kept} {time.time()-t0:.0f}s {path}")
        time.sleep(args.pace)
    log(f"RUN-END {args.tag} processed={len(todo)} total_kept={total}")


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""mem0-token — manage scoped MCP access tokens for the configured memory store.

Tokens are generated with `openssl rand -base64 36`, written to a 0600 file
under data/tokens/, and recorded in data/mcp-tokens.json as a SHA-256 hash
only. This tool NEVER prints a token value and the store never holds one.
To hand a token to a person, send them the file (or its contents) over a
channel you trust, then delete the file.

  mem0-token list
  mem0-token grant example-user --scopes team:project,client:*,person:example-user
  mem0-token grant-hash fleet-bow --sha256 <remote-generated-sha256> --scopes team:project,ops
  mem0-token rotate example-user
  mem0-token revoke example-user
  mem0-token scopes                       # every scope name currently valid
"""

import argparse
import fcntl
import os
import tempfile
import hashlib
import importlib.machinery
import json
import re
import subprocess
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
CONFIG = importlib.machinery.SourceFileLoader("borg_config_token", str(BIN / "borg_config.py")).load_module().CONFIG
BASE = CONFIG.mem0_root
LIB = importlib.machinery.SourceFileLoader("mem0_scope_lib", str(BIN / "mem0_scope_lib.py")).load_module()
CTL = importlib.machinery.SourceFileLoader("mem0ctl_mod", str(BIN / "mem0ctl")).load_module()

TOKENS_F = BASE / "data/mcp-tokens.json"
LEGACY_F = BASE / "data/mcp-token"
TOKEN_DIR = BASE / "data/tokens"


def sha(t: str) -> str:
    return hashlib.sha256(t.encode()).hexdigest()


def load() -> dict:
    if not TOKENS_F.exists():
        principals = []
        if LEGACY_F.exists() and LEGACY_F.read_text().strip():
            principals.append(
                {
                    "name": CONFIG.owner_id,
                    "token_sha256": sha(LEGACY_F.read_text().strip()),
                    "allowed_scopes": ["*"],
                    "write_scope": LIB.SCOPE_PERSONAL,
                    "created_mdt": CTL.now_mdt(),
                    "note": "imported from data/mcp-token (v1 single-token) — unchanged, still valid",
                }
            )
        save({"version": 1, "principals": principals})
    return json.loads(TOKENS_F.read_text())


def atomic_private_write(path: Path, text: str):
    """Publish a complete 0600 file; readers never observe a partial registry."""
    fd, name = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def save(doc: dict):
    # A supported writer must never publish identities the reader rejects.
    names, hashes = set(), set()
    for entry in doc["principals"]:
        name, digest = entry.get("name"), entry.get("token_sha256")
        if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", name):
            sys.exit("invalid principal name; registry unchanged")
        if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
            sys.exit("invalid principal hash; registry unchanged")
        if name in names or digest in hashes:
            sys.exit("duplicate principal name or token hash; registry unchanged")
        names.add(name)
        hashes.add(digest)
    atomic_private_write(TOKENS_F, json.dumps(doc, indent=2))


def may_write_scope(scope: str, allowed: list[str], valid: set[str]) -> bool:
    if scope not in valid or "*" in scope:
        return False
    return ("*" in allowed or scope in allowed or
            (scope.startswith(LIB.SCOPE_CLIENT_PREFIX) and
             LIB.SCOPE_CLIENT_PREFIX + "*" in allowed))


def valid_scopes(extra_people=()) -> list[str]:
    clients = LIB.load_clients()
    people = {p["name"] for p in (load_raw().get("principals") or []) if p["name"] != CONFIG.owner_id}
    people.update(extra_people)
    return (
        ["*", LIB.SCOPE_PERSONAL, LIB.SCOPE_PROJECT, LIB.SCOPE_OPS, LIB.SCOPE_CLIENT_PREFIX + "*"]
        + [LIB.SCOPE_CLIENT_PREFIX + s for s in sorted(clients)]
        + [LIB.SCOPE_PERSON_PREFIX + p for p in sorted(people)]
    )


def load_raw() -> dict:
    """Read the store without bootstrapping (used by valid_scopes to avoid recursion)."""
    if TOKENS_F.exists():
        try:
            return json.loads(TOKENS_F.read_text())
        except Exception:
            pass
    return {"principals": []}


def gen_token() -> str:
    out = subprocess.run(["openssl", "rand", "-base64", "36"], capture_output=True, text=True, check=True)
    return out.stdout.strip().replace("+", "-").replace("/", "_").rstrip("=")


def write_token_file(name: str, token: str) -> Path:
    TOKEN_DIR.mkdir(parents=True, exist_ok=True)
    TOKEN_DIR.chmod(0o700)
    p = TOKEN_DIR / f"{name}.token"
    atomic_private_write(p, token + "\n")
    return p


def cmd_list(args):
    doc = load()
    if not doc["principals"]:
        print("(no principals)")
        return
    for p in doc["principals"]:
        print(f"{p['name']:12s} scopes={','.join(p['allowed_scopes'])}")
        print(f"{'':12s} write={p.get('write_scope','')}  created={p.get('created_mdt','?')}")
        print(f"{'':12s} sha256={p['token_sha256'][:16]}…  {p.get('note','')}")


def cmd_scopes(args):
    for s in valid_scopes():
        print(s)


def cmd_grant(args):
    scopes = [s.strip() for s in args.scopes.split(",") if s.strip()]
    # a new principal may always be granted its own person: scope
    ok = set(valid_scopes(extra_people=[args.name]))
    bad = [s for s in scopes if s not in ok]
    if bad:
        sys.exit(f"unknown scope(s): {', '.join(bad)}\nrun `mem0-token scopes` for the valid list")
    doc = load()
    if any(p["name"] == args.name for p in doc["principals"]):
        sys.exit(f"principal {args.name!r} already exists — use `rotate` to reissue its token")
    token = gen_token()
    write_scope = args.write_scope or f"{LIB.SCOPE_PERSON_PREFIX}{args.name}"
    if not may_write_scope(write_scope, scopes, ok):
        sys.exit("--write-scope must be one of the principal allowed scopes")
    doc["principals"].append(
        {
            "name": args.name,
            "token_sha256": sha(token),
            "allowed_scopes": scopes,
            "write_scope": write_scope,
            "created_mdt": CTL.now_mdt(),
            "note": args.note,
        }
    )
    save(doc)
    f = write_token_file(args.name, token)
    print(f"granted {args.name}: {','.join(scopes)}  (writes land in {write_scope})")
    print(f"token written to {f}  (mode 600) — never printed, never committed")
    print("hand it over, then: rm " + str(f))


def cmd_grant_hash(args):
    """Register a token hash generated on another owned machine.

    The plaintext token never reaches the memory server. This is the required remote path.
    """
    if not re.fullmatch(r"[0-9a-f]{64}", args.sha256):
        sys.exit("--sha256 must be 64 lowercase hex characters")
    scopes = [s.strip() for s in args.scopes.split(",") if s.strip()]
    ok = set(valid_scopes(extra_people=[args.name]))
    bad = [s for s in scopes if s not in ok]
    if bad:
        sys.exit(f"unknown scope(s): {', '.join(bad)}\nrun `mem0-token scopes` for the valid list")
    doc = load()
    if any(p["name"] == args.name for p in doc["principals"]):
        sys.exit(f"principal {args.name!r} already exists — revoke it before registering a new remote hash")
    write_scope = args.write_scope or LIB.SCOPE_PROJECT
    if not may_write_scope(write_scope, scopes, ok):
        sys.exit("--write-scope must be one of the principal's allowed scopes")
    doc["principals"].append(
        {
            "name": args.name,
            "token_sha256": args.sha256,
            "allowed_scopes": scopes,
            "write_scope": write_scope,
            "created_mdt": CTL.now_mdt(),
            "note": args.note or "remote-generated token; plaintext never reached the memory server",
        }
    )
    save(doc)
    print(f"registered remote hash for {args.name}: {','.join(scopes)}  (writes land in {write_scope})")


def cmd_rotate(args):
    doc = load()
    for p in doc["principals"]:
        if p["name"] == args.name:
            token = gen_token()
            p["token_sha256"] = sha(token)
            p["rotated_mdt"] = CTL.now_mdt()
            save(doc)
            f = write_token_file(args.name, token)
            print(f"rotated {args.name}; the live v2 server revalidates on the next request")
            print(f"token written to {f}  (mode 600)")
            return
    sys.exit(f"no principal {args.name!r}")


def cmd_revoke(args):
    doc = load()
    n = len(doc["principals"])
    doc["principals"] = [p for p in doc["principals"] if p["name"] != args.name]
    if len(doc["principals"]) == n:
        sys.exit(f"no principal {args.name!r}")
    save(doc)
    f = TOKEN_DIR / f"{args.name}.token"
    if f.exists():
        f.unlink()
    print(f"revoked {args.name} — the live v2 server revalidates on the next request")


def main():
    ap = argparse.ArgumentParser(prog="mem0-token", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list").set_defaults(fn=cmd_list)
    sub.add_parser("scopes").set_defaults(fn=cmd_scopes)
    g = sub.add_parser("grant")
    g.add_argument("name")
    g.add_argument("--scopes", required=True, help="comma-separated; see `mem0-token scopes`")
    g.add_argument("--write-scope", default=None, help="default: person:<name>")
    g.add_argument("--note", default="")
    g.set_defaults(fn=cmd_grant)
    gh = sub.add_parser("grant-hash")
    gh.add_argument("name")
    gh.add_argument("--sha256", required=True)
    gh.add_argument("--scopes", required=True, help="comma-separated; see `mem0-token scopes`")
    gh.add_argument("--write-scope", default=None)
    gh.add_argument("--note", default="")
    gh.set_defaults(fn=cmd_grant_hash)
    r = sub.add_parser("rotate"); r.add_argument("name"); r.set_defaults(fn=cmd_rotate)
    v = sub.add_parser("revoke"); v.add_argument("name"); v.set_defaults(fn=cmd_revoke)
    a = ap.parse_args()
    if hasattr(a, "name") and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", a.name):
        ap.error("principal name must be a safe identifier")
    # Serialize the full read/modify/publish transaction, not just its write.
    TOKENS_F.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(TOKENS_F) + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(fd, "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        a.fn(a)


if __name__ == "__main__":
    main()

    t0 = time.monotonic()
    try:
        rows, graph_keys = _graph_rows_for(
            p,
            "entity_timeline",
            entity,
            _bounded_limit(limit, 50),
            current_only=False,
        )
    except Exception as exc:
        _graph_receipt(
            p,
            "memory_entity_timeline",
            "UNKNOWN",
            int((time.monotonic() - t0) * 1000),
            reason=type(exc).__name__,
        )
        return json.dumps({"status": "UNKNOWN", "entity": entity, "results": []})
    _graph_receipt(
        p,
        "memory_entity_timeline",
        "PASS",
        int((time.monotonic() - t0) * 1000),
        result_count=len(rows),
        graph_count=len(graph_keys),
    )
    return json.dumps(
        {"status": "PASS", "entity": entity, "results": rows},
        default=str,
        ensure_ascii=False,
    )


@mcp.tool
def memory_graph_stats() -> str:
    """Return counts for only the graph groups this principal may inspect."""
    p = who()
    _require_graph_enabled()
    t0 = time.monotonic()
    try:
        stats, graph_keys = _graph_stats_for(p)
    except Exception as exc:
        _graph_receipt(
            p,
            "memory_graph_stats",
            "UNKNOWN",
            int((time.monotonic() - t0) * 1000),
            reason=type(exc).__name__,
        )
        return json.dumps({"status": "UNKNOWN", "graphs": {}})
    _graph_receipt(
        p,
        "memory_graph_stats",
        "PASS",
        int((time.monotonic() - t0) * 1000),
        graph_count=len(graph_keys),
    )
    return json.dumps(
        {"status": "PASS", **stats},
        default=str,
        ensure_ascii=False,
    )


@mcp.tool
def memory_add(text: str, agent: str = "", run_id: str = "", raw: bool = False, scope: str = "") -> str:
    """Store a durable fact in configured BORG memory. One plain sentence per
    fact works best. NEVER store credentials, tokens, cookies, client personal
    data (emails/phones/addresses), or dollar amounts. Set raw=true to store
    verbatim (skips LLM distillation). Pass your agent name in `agent`.
    `scope` defaults to your own write scope; you may only name a scope your
    token already allows."""
    p = who()
    target = scope or p.write_scope
    if not p.may_write(target, CLIENTS):
        raise ToolError(f"principal {p.name!r} may not write scope {target!r}")

    def do(model_key):
        return M(model_key).add(
            [{"role": "user", "content": text}],
            user_id=USER,
            agent_id=agent or None,
            run_id=run_id or None,
            metadata={
                "added_mdt": CTL.now_mdt(),
                "source": "mcp",
                "scope": target,
                "written_by": p.name,
            },
            infer=not raw,
        )

    try:
        res, used = do("qwen"), "qwen"
    except Exception:
        res, used = do("llama"), "llama"
    events = _rows(res)
    if not events:
        return json.dumps(
            {
                "model": CTL.MODELS[used],
                "events": [],
                "scope": target,
                "note": "no memory change — extractor found nothing new; retry with raw=true to store verbatim",
            }
        )
    return json.dumps({"model": CTL.MODELS[used], "scope": target, "events": events}, default=str, ensure_ascii=False)


@mcp.tool
def memory_capture_verified_finding(
    finding: str,
    kind: str,
    scope: str,
    source_system: str,
    source_event_id: str,
    source_version: str,
    observed_at: str,
    evidence_json: str | list[dict],
    valid_at: str | None = None,
    invalid_at: str | None = None,
    supersedes_version: str | None = None,
) -> str:
    """Store one authenticated, admitted finding at a deterministic native ID.

    ``run_id`` is a stable attribution field only.  It is never consulted for
    duplicate detection; the native point and its ADD history are authoritative.
    """
    p = who()
    if not isinstance(scope, str) or not scope.strip():
        raise ToolError("explicit target scope is required")
    try:
        target_scope = CAPTURE.normalize_text(scope, "scope")
    except ValueError as exc:
        raise ToolError("invalid target scope") from exc
    if not p.may_write(target_scope, CLIENTS):
        raise ToolError(f"principal {p.name!r} may not write scope {target_scope!r}")

    try:
        identity = CAPTURE.build_identity(
            principal=p.name,
            scope=target_scope,
            source_system=source_system,
            source_event_id=source_event_id,
            source_version=source_version,
        )
        evidence = _capture_admission(finding, kind, evidence_json)
        payload = CAPTURE.payload_document(
            identity=identity,
            finding=finding,
            kind=kind,
            observed_at=observed_at,
            evidence=evidence,
            valid_at=valid_at,
            invalid_at=invalid_at,
            supersedes_version=supersedes_version,
        )
        clean_finding = payload["document"]["finding"]
    except Exception as exc:
        if isinstance(exc, ToolError):
            raise
        raise ToolError("invalid or inadmissible verified finding") from exc

    # Embedding is the only native operation allowed before the event lock.
    try:
        memory = M()
        embedding = _verified_embed(memory, clean_finding)
    except Exception:
        return _verified_unknown(
            identity,
            payload,
            target_scope,
            reason="embedding",
            principal=p,
        )

    lock = acquire_verified_event_lock(identity["event_lock_key"])
    if lock is None:
        return _verified_unknown(
            identity,
            payload,
            target_scope,
            reason="lock-timeout",
            principal=p,
        )
    try:
        try:
            existed, history_reconciled, receipt_reconciled = _capture_verified_native(
                memory,
                embedding,
                identity,
                payload,
                clean_finding,
                p,
                target_scope,
            )
        except _VerifiedConflict:
            _verified_log(
                "CONFLICT",
                p,
                identity_sha256=identity["identity_sha256"],
                payload_sha256=payload["payload_sha256"],
                scope=target_scope,
                memory_id=identity["memory_id"],
            )
            return _verified_response("CONFLICT", identity, payload, target_scope)
        except OSError as exc:
            message = str(exc)
            reason = "native-read"
            if "write" in message or "absent after" in message:
                reason = "native-write"
            elif "history" in message:
                reason = "history-write" if "write" in message else "history-read"
            elif "receipt" in message:
                reason = "receipt-write" if "write" in message else "receipt-read"
            return _verified_unknown(
                identity,
                payload,
                target_scope,
                reason=reason,
                principal=p,
            )
        except Exception:
            return _verified_unknown(
                identity,
                payload,
                target_scope,
                reason="native-read",
                principal=p,
            )
        status = "ALREADY_COMMITTED" if existed else "COMMITTED"
        _verified_log(
            status,
            p,
            identity_sha256=identity["identity_sha256"],
            payload_sha256=payload["payload_sha256"],
            scope=target_scope,
            memory_id=identity["memory_id"],
            history_reconciled=history_reconciled,
            receipt_reconciled=receipt_reconciled,
        )
        return _verified_response(
            status,
            identity,
            payload,
            target_scope,
            point_verified=True,
            history_reconciled=history_reconciled,
            receipt_reconciled=receipt_reconciled,
        )
    finally:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
        except OSError:
            pass
        lock.close()


@mcp.tool
def memory_lifecycle_capture(
    records_json: str,
    session: str,
    cwd: str,
    machine: str,
    harness: str,
    digest: str,
    completed: bool = True,
    dry_run: bool = False,
    source_system: str = "",
    source_event_id: str = "",
    source_version: str = "",
    identity_quality: str = "",
    source_range_start: StrictInt | None = None,
    source_range_end: StrictInt | None = None,
) -> str:
    """Capture durable, supported facts from redacted lifecycle evidence.

    This tool is for the fleet hook only. It rechecks evidence before the
    existing configured extractor and store run. It never accepts assistant text.
    """
    p = who()
    machine = re.sub(r"[^A-Za-z0-9._-]+", "_", str(machine))[:80] or "unknown"
    harness = str(harness or "")
    session = re.sub(r"[^A-Za-z0-9._-]+", "_", str(session))[:180] or "unknown"
    if harness not in {"codex", "claude", "grok", "hermes"}:
        raise ToolError("unsupported harness")
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise ToolError("invalid evidence digest")
    if HOOK_OFF.exists():
        return json.dumps({"status": "KILL_SWITCH"})
    records, pre_rejected = lifecycle_records(records_json)
    if identity_quality not in {"", "legacy_session"}:
        raise ToolError("unsupported identity_quality")
    reported_identity_quality = identity_quality
    canonical_source = any(value != "" for value in (source_system, source_event_id, source_version))
    if canonical_source:
        # New clients bind the exact submitted bytes. Safety filtering must not
        # silently change the records whose digest the client authenticated.
        if json.loads(records_json) != records:
            raise ToolError("evidence changed by safety filter")
        computed = hashlib.sha256(records_json.encode("utf-8")).hexdigest()
    else:
        computed = hashlib.sha256(json.dumps(records, sort_keys=True, ensure_ascii=True).encode()).hexdigest()
    if computed != digest:
        fleet_log("REJECT", principal=p.name, machine=machine, harness=harness, digest=digest[:16], reason="digest-mismatch", rejected=pre_rejected)
        raise ToolError("evidence digest mismatch after safety filter")
    if not completed:
        return json.dumps({"status": "SKIP_INTERRUPTED", "rejected": pre_rejected})
    if dry_run:
        return json.dumps({"status": "PASS_DRY_RUN", "records": len(records), "rejected": pre_rejected})

    target_scope = p.write_scope
    if not p.may_write(target_scope, CLIENTS):
        raise ToolError("principal write scope is not allowed")
    identity, identity_quality, source_system, source_event_id, source_version = _lifecycle_identity(
        p,
        target_scope,
        session,
        harness,
        digest,
        machine,
        source_system,
        source_event_id,
        source_version,
        source_range_start,
        source_range_end,
    )
    if reported_identity_quality == "legacy_session":
        identity_quality = "legacy_session"
    receipt = lifecycle_receipt(
        p.name,
        scope=target_scope,
        source_system=source_system,
        source_event_id=source_event_id,
        source_version=source_version,
    )
    legacy_receipt = lifecycle_legacy_receipt(p.name, machine, harness, digest)
    manifest_path = lifecycle_prepared_manifest_path(receipt)
    expected_manifest = {
        "digest": digest,
        "parent_identity": identity,
        "identity_quality": identity_quality,
        "source_system": source_system,
        "source_event_id": source_event_id,
        "source_version": source_version,
        "pre_rejected": pre_rejected,
    }
    lock = acquire_lifecycle_event_lock(identity["event_lock_key"])
    if lock is None:
        fleet_log("FAIL_OPEN", principal=p.name, machine=machine, harness=harness, digest=digest[:16], reason="event-lock")
        return json.dumps({"status": "FAIL_OPEN"})
    try:
        try:
            if receipt.exists():
                if _lifecycle_terminal_receipt_valid(
                    receipt, expected_manifest, records, manifest_path
                ):
                    return json.dumps({"status": "SKIP_DUP"})
                fleet_log(
                    "FAIL_OPEN",
                    principal=p.name,
                    machine=machine,
                    harness=harness,
                    digest=digest[:16],
                    reason="receipt-invalid",
                )
                return json.dumps({"status": "FAIL_OPEN"})
            if not canonical_source and legacy_receipt.exists():
                return json.dumps({"status": "SKIP_DUP"})
        except OSError:
            fleet_log("FAIL_OPEN", principal=p.name, machine=machine, harness=harness, digest=digest[:16], reason="receipt-read")
            return json.dumps({"status": "FAIL_OPEN"})

        run_id = f"lifecycle:{identity['identity_sha256'][:32]}"
        if not records:
            try:
                terminal_receipt = {
                    "schema": LIFECYCLE_RECEIPT_SCHEMA,
                    "status": "empty",
                    "digest": digest,
                    "principal": p.name,
                    "identity_sha256": identity["identity_sha256"],
                    "identity_quality": identity_quality,
                    "run_id": run_id,
                    "stored": 0,
                    "skipped": 0,
                    "rejected": pre_rejected,
                    "prepared_manifest_sha256": None,
                    "at": CTL.now_iso(),
                }
                LIFECYCLE.atomic_json(receipt, terminal_receipt)
                if not _lifecycle_terminal_receipt_valid(
                    receipt, expected_manifest, records, manifest_path
                ):
                    raise OSError("empty receipt readback mismatch")
            except Exception:
                fleet_log("FAIL_OPEN", principal=p.name, machine=machine, harness=harness, digest=digest[:16], reason="receipt-write")
                return json.dumps({"status": "FAIL_OPEN"})
            return json.dumps({"status": "PASS_EMPTY", "stored": 0, "rejected": pre_rejected})

        t0 = time.monotonic()

        def create_manifest():
            if not _lifecycle_extraction_lock.acquire(blocking=False):
                raise _LifecycleExtractionBusy
            try:
                extracted = LIFECYCLE.default_extractor(records)
            finally:
                _lifecycle_extraction_lock.release()
            candidates, candidate_rejected = _lifecycle_manifest_candidates(
                extracted,
                records,
                identity,
                source_event_id,
                source_version,
            )
            observed_at = CAPTURE.normalize_timestamp(
                datetime.now(timezone.utc).isoformat(), "observed_at"
            )
            return _lifecycle_manifest(
                parent_identity=identity,
                identity_quality=identity_quality,
                digest=digest,
                source_system=source_system,
                source_event_id=source_event_id,
                source_version=source_version,
                observed_at=observed_at,
                machine=machine,
                harness=harness,
                cwd=cwd,
                session=session,
                candidates=candidates,
                rejected=pre_rejected + candidate_rejected,
            )

        try:
            manifest = _lifecycle_load_or_create_manifest(
                manifest_path,
                expected_manifest,
                records,
                create_manifest,
            )
            memory = M()
            for candidate in manifest["candidates"]:
                payload = _lifecycle_candidate_payload(manifest, candidate)
                embedding = _verified_embed(memory, candidate["fact"])
                _capture_verified_native(
                    memory,
                    embedding,
                    candidate["identity"],
                    payload,
                    candidate["fact"],
                    p,
                    target_scope,
                    created_at=manifest["observed_at"],
                    lifecycle_metadata=manifest["lifecycle_metadata"],
                    capture_schema=LIFECYCLE_CAPTURE_SCHEMA,
                    agent_id=LIFECYCLE_CAPTURE_AGENT,
                    provenance=LIFECYCLE_CAPTURE_PROVENANCE,
                    run_id_prefix=LIFECYCLE_CAPTURE_AGENT,
                )
            stored = len(manifest["candidates"])
            skipped = manifest["skipped"]
            rejected = manifest["rejected"]
        except _LifecycleExtractionBusy:
            fleet_log("FAIL_OPEN", principal=p.name, machine=machine, harness=harness, digest=digest[:16], reason="extraction-busy", elapsed_ms=int((time.monotonic() - t0) * 1000))
            return json.dumps({"status": "BUSY", "retry_after_seconds": 5})
        except Exception:
            fleet_log("FAIL_OPEN", principal=p.name, machine=machine, harness=harness, digest=digest[:16], reason="service-unavailable", elapsed_ms=int((time.monotonic() - t0) * 1000))
            return json.dumps({"status": "FAIL_OPEN"})

        try:
            terminal_receipt = {
                "schema": LIFECYCLE_RECEIPT_SCHEMA,
                "status": "complete",
                "digest": digest,
                "principal": p.name,
                "identity_sha256": identity["identity_sha256"],
                "identity_quality": identity_quality,
                "run_id": run_id,
                "stored": stored,
                "skipped": skipped,
                "rejected": rejected,
                "prepared_manifest_sha256": manifest["manifest_sha256"],
                "at": CTL.now_iso(),
            }
            LIFECYCLE.atomic_json(receipt, terminal_receipt)
            if not _lifecycle_terminal_receipt_valid(
                receipt, expected_manifest, records, manifest_path
            ):
                raise OSError("terminal receipt readback mismatch")
        except Exception:
            fleet_log("FAIL_OPEN", principal=p.name, machine=machine, harness=harness, digest=digest[:16], reason="receipt-write", elapsed_ms=int((time.monotonic() - t0) * 1000))
            return json.dumps({"status": "FAIL_OPEN"})
        fleet_log("PASS", principal=p.name, machine=machine, harness=harness, digest=digest[:16], stored=stored, skipped=skipped, rejected=rejected, elapsed_ms=int((time.monotonic() - t0) * 1000))
        return json.dumps({"status": "PASS", "stored": stored, "skipped": skipped, "rejected": rejected})
    finally:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
        except OSError:
            pass
        lock.close()


@mcp.tool
def memory_list(limit: int = 20, agent: str = "") -> str:
    """List stored memories you are allowed to see (up to `limit`)."""
    p = who()
    return _fmt(scope_guard(p, _rows(M().get_all(filters=read_filters(p, agent), top_k=limit))))


@mcp.tool
def memory_delete(memory_id: str) -> str:
    """Delete one memory by its id. You may only delete a row you can read."""
    p = who()
    if not p.full_access:
        q = LIB.qdrant()
        try:
            pts = q.retrieve(LIB.COLLECTION, ids=[memory_id], with_payload=True)
            if not pts:
                raise ToolError("not found")
            row_scope = (pts[0].payload or {}).get("scope")
            if row_scope not in p.concrete_scopes(CLIENTS):
                raise ToolError("not found")  # do not confirm existence out of scope
        finally:
            q.close()
    M().delete(memory_id)
    return json.dumps({"deleted": memory_id})


@mcp.tool
def memory_stats() -> str:
    """Count the memories visible to you and show the per-scope breakdown."""
    p = who()
    from qdrant_client.models import FieldCondition, Filter, MatchAny, MatchValue

    q = LIB.qdrant()
    try:
        must = [FieldCondition(key="user_id", match=MatchValue(value=USER))]
        if not p.full_access:
            must.append(FieldCondition(key="scope", match=MatchAny(any=p.concrete_scopes(CLIENTS))))
        flt = Filter(must=must, must_not=[FieldCondition(key="is_canary", match=MatchValue(value=True))])
        total = q.count(LIB.COLLECTION, count_filter=flt, exact=True).count
        by_scope = {}
        try:
            for hit in q.facet(LIB.COLLECTION, key="scope", facet_filter=flt, limit=200, exact=True).hits:
                by_scope[str(hit.value)] = hit.count
        except Exception:
            pass
    finally:
        q.close()
    unscoped = total - sum(by_scope.values())
    if unscoped > 0:
        by_scope["(unscoped — owner only)"] = unscoped
    return json.dumps({"principal": p.name, "visible": total, "by_scope": by_scope})


@mcp.tool
def memory_whoami() -> str:
    """Report which principal this token maps to and which scopes it can read."""
    p = who()
    return json.dumps(
        {
            "principal": p.name,
            "allowed_scopes": p.allowed,
            "effective_read_scopes": "ALL (including unscoped)" if p.full_access else p.concrete_scopes(CLIENTS),
            "write_scope": p.write_scope,
        }
    )


if __name__ == "__main__":
    if HTTP_MODE:
        i = sys.argv.index("--http")
        port = int(sys.argv[i + 1]) if len(sys.argv) > i + 1 and sys.argv[i + 1].isdigit() else 8765
        # Each capture is an independent HTTP call. Stateful mode retains every
        # MCP transport indefinitely in FastMCP 3.4.7 (no idle timeout).
        mcp.run(transport="http", host="127.0.0.1", port=port, stateless_http=True)
    else:
        # Parent-death watchdog (leak fix 2026-08-28): stdio children must die
        # with their client. 679 orphans were measured holding 13.7 GB after
        # clients (codex conductors, hermes roles) exited without closing the
        # pipe. Exit only when our PPID *changes* to 1 — a process launchd
        # started with PPID 1 from birth is a service and never trips this.
        import threading, time as _time

        _birth_ppid = os.getppid()
        if _birth_ppid != 1:
            def _watch_parent():
                while True:
                    if os.getppid() == 1:
                        os._exit(0)
                    _time.sleep(15)

            threading.Thread(target=_watch_parent, daemon=True).start()
        mcp.run()

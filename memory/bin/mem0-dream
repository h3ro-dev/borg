#!/usr/bin/env python3
"""Bounded memory census and opt-in reversible retention maintenance.

The census requests metadata only. When MEM0_DREAM_RETENTION_ENABLED=1,
maintenance retrieves full payloads for duplicate or explicitly classified
candidates and writes only owned retirement markers with a restore journal.
Original facts, vectors, and source history remain intact. No model calls.
"""

from __future__ import annotations

import argparse
from datetime import date, datetime, timezone
import fcntl
import hashlib
import json
import importlib.machinery
import os
from pathlib import Path
import re
import signal
import time
import urllib.request

CONFIG = importlib.machinery.SourceFileLoader(
    "borg_config_dream", str(Path(__file__).resolve().parent / "borg_config.py")
).load_module().CONFIG

BASE = CONFIG.mem0_root
SCHEMA = "dream-maintenance-v1"
MAX_RUNTIME_S = 600.0
MAX_SCAN_POINTS = 200_000
DEFAULT_PAGE_SIZE = 1_000
HTTP_TIMEOUT_S = 30.0
RETIRED_STATUSES = frozenset({"tombstoned", "decayed"})
METADATA_FIELDS = (
    "hash",
    "scope",
    "status",
    "is_canary",
    "canary",
    "retention_class",
    "expiration_date",
    "expires_at",
    "valid_until",
    "updated_at",
)
EXPIRY_FIELDS = ("expiration_date", "expires_at", "valid_until")
DURABLE_RETENTION = "durable"
DATE_RE = re.compile(r"\d{4}-\d{2}-\d{2}", re.ASCII)


class DeadlineExceeded(RuntimeError):
    """The bounded maintenance budget ended before the scan completed."""


class RunInterrupted(RuntimeError):
    """The process received a termination signal during maintenance."""


def _canonical(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def _sha256(value):
    return hashlib.sha256(value).hexdigest()


def _sha256_file(path):
    try:
        return _sha256(path.read_bytes())
    except OSError:
        return "UNAVAILABLE"


def _now_mdt():
    try:
        from zoneinfo import ZoneInfo

        return datetime.now(timezone.utc).astimezone(ZoneInfo("America/Denver"))
    except Exception:
        return datetime.now(timezone.utc)


def _log(message, log_path):
    line = f"{_now_mdt().isoformat(timespec='seconds')} {message}"
    try:
        log_path.parent.mkdir(parents=True, exist_ok=True)
        with log_path.open("a", encoding="utf-8") as handle:
            handle.write(line + "\n")
    except OSError:
        pass
    print(message, flush=True)


def _env_float(name, default, maximum):
    raw = os.environ.get(name)
    try:
        value = float(raw) if raw is not None else float(default)
    except (TypeError, ValueError):
        value = float(default)
    return min(maximum, max(0.01, value))


def _env_int(name, default, maximum):
    raw = os.environ.get(name)
    try:
        value = int(raw) if raw is not None else int(default)
    except (TypeError, ValueError):
        value = int(default)
    return min(maximum, max(1, value))


class _Budget:
    def __init__(self, seconds):
        self.started = time.monotonic()
        self.deadline = self.started + seconds

    def remaining(self):
        return self.deadline - time.monotonic()

    def check(self):
        if self.remaining() <= 0:
            raise DeadlineExceeded("deadline")

    def timeout(self):
        self.check()
        return min(HTTP_TIMEOUT_S, self.remaining())


def _http_json(url, body, timeout_s):
    request = urllib.request.Request(
        url,
        data=_canonical(body).encode("utf-8"),
        headers={"Accept": "application/json", "Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=timeout_s) as response:
        return json.loads(response.read().decode("utf-8"))


def _qdrant_url():
    return str(CONFIG.values["BORG_QDRANT_URL"]).rstrip("/")


def _collection():
    return str(CONFIG.values["BORG_QDRANT_COLLECTION"])


def _path_config(data_dir=None, lock_path=None, receipt_path=None, cache_path=None, log_path=None):
    root = Path(data_dir) if data_dir is not None else Path(
        os.environ.get("MEM0_DREAM_DATA_DIR", str(BASE / "data"))
    )
    return {
        "data": root,
        "lock": Path(lock_path) if lock_path is not None else Path(
            os.environ.get("MEM0_DREAM_LOCK", str(root / "dream-maintenance.lock"))
        ),
        "receipt": Path(receipt_path) if receipt_path is not None else Path(
            os.environ.get("MEM0_DREAM_RECEIPT", str(root / "dream-maintenance.receipt.json"))
        ),
        "cache": Path(cache_path) if cache_path is not None else Path(
            os.environ.get("MEM0_DREAM_CACHE", str(root / "dream-maintenance.cache.json"))
        ),
        "log": Path(log_path) if log_path is not None else Path(
            os.environ.get("MEM0_DREAM_LOG", str(root / "dream.log"))
        ),
    }


def _dream_off(_paths):
    configured = os.environ.get("MEM0_DREAM_OFF")
    sentinel = Path(configured) if configured else BASE / "DREAM_OFF"
    return sentinel.exists()


def _acquire_lock(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    os.fchmod(fd, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        os.close(fd)
        return None
    return fd


def _release_lock(fd):
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


def _atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _read_json(path):
    if not path.exists():
        return None, "MISSING"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return None, "CORRUPT"
    if not isinstance(value, dict):
        return None, "CORRUPT"
    if value.get("schema") != SCHEMA or value.get("complete") is not True:
        return value, "INCOMPLETE"
    if not isinstance(value.get("fingerprint"), str):
        return value, "INCOMPLETE"
    return value, "VALID"


def _scope_key(payload):
    if "scope" not in payload:
        return ("missing", "")
    value = payload.get("scope")
    return (type(value).__name__, repr(value))


def _scope_digest(scope_key):
    return _sha256(_canonical(scope_key).encode("utf-8"))


def _mapping_containers(value):
    """Walk all metadata containers without choosing a preferred one."""

    pending = [value]
    seen = set()
    while pending:
        container = pending.pop(0)
        if not isinstance(container, dict) or id(container) in seen:
            continue
        seen.add(id(container))
        yield container
        for key in ("metadata", "payload"):
            nested = container.get(key)
            if isinstance(nested, dict):
                pending.append(nested)


def _valid_expiry(value, today):
    values = [
        container[field]
        for container in _mapping_containers(value)
        for field in EXPIRY_FIELDS
        if field in container
    ]
    if not values:
        return "unknown"
    if any(
        isinstance(container.get("retention_class"), str)
        and container["retention_class"].strip().casefold() == DURABLE_RETENTION
        for container in _mapping_containers(value)
    ):
        return "unknown"
    parsed_values = []
    for raw in values:
        if not isinstance(raw, str) or DATE_RE.fullmatch(raw) is None:
            return "unknown"
        try:
            parsed_values.append(date.fromisoformat(raw))
        except ValueError:
            return "unknown"
    if len(set(parsed_values)) != 1:
        return "unknown"
    return "expired" if parsed_values[0] < today else "active"


def _is_canary(payload):
    return payload.get("is_canary") is True or payload.get("canary") is True


def _is_active(point):
    payload = point.get("payload") if isinstance(point, dict) else None
    return (
        isinstance(payload, dict)
        and payload.get("status") not in RETIRED_STATUSES
        and not _is_canary(payload)
    )


def _point_record(point, today):
    payload = point.get("payload")
    point_id = point.get("id")
    if not isinstance(payload, dict) or point_id is None:
        return None
    selected = {field: payload.get(field) for field in METADATA_FIELDS if field in payload}
    selected["id"] = str(point_id)
    payload_digest = _sha256(_canonical(selected).encode("utf-8"))
    version = {
        field: payload.get(field)
        for field in ("hash", "updated_at")
        if field in payload
    }
    scope_key = _scope_key(payload)
    return {
        "id": str(point_id),
        "hash": payload.get("hash") if isinstance(payload.get("hash"), str) else None,
        "scope_key": scope_key,
        "scope_sha256": _scope_digest(scope_key),
        "payload_sha256": payload_digest,
        "payload_version": version,
        "expiry": _valid_expiry(point, today),
    }


def _scroll_source(budget, max_points, page_size, http_fn):
    url = f"{_qdrant_url()}/collections/{_collection()}/points/scroll"
    offset = None
    seen_offsets = set()
    points = []
    pages = 0
    try:
        while len(points) < max_points:
            budget.check()
            request_limit = min(page_size, max_points - len(points))
            body = {
                "limit": request_limit,
                "with_payload": list(METADATA_FIELDS),
                "with_vector": False,
                "filter": {
                    "must_not": [
                        {"key": "status", "match": {"value": status}}
                        for status in sorted(RETIRED_STATUSES)
                    ]
                    + [
                        {"key": "is_canary", "match": {"value": True}},
                        {"key": "canary", "match": {"value": True}},
                    ],
                },
            }
            if offset is not None:
                body["offset"] = offset
            payload = http_fn(url, body, budget.timeout())
            result = payload.get("result") if isinstance(payload, dict) else None
            page = result.get("points") if isinstance(result, dict) else None
            if not isinstance(page, list):
                raise ValueError("malformed-page")
            points.extend(point for point in page if isinstance(point, dict))
            pages += 1
            next_offset = result.get("next_page_offset") if isinstance(result, dict) else None
            if next_offset is None and len(page) <= request_limit and len(points) <= max_points:
                return points[:max_points], pages, "COMPLETE", "complete"
            if next_offset is None:
                return points[:max_points], pages, "PARTIAL", "scan-cap"
            marker = _canonical(next_offset)
            if marker in seen_offsets:
                return points[:max_points], pages, "PARTIAL", "offset-loop"
            seen_offsets.add(marker)
            offset = next_offset
    except DeadlineExceeded:
        return points[:max_points], pages, "PARTIAL", "deadline"
    return points[:max_points], pages, "PARTIAL", "scan-cap"


def _source_policy_hash():
    policy = {
        "schema": SCHEMA,
        "metadata_fields": METADATA_FIELDS,
        "expiry_fields": EXPIRY_FIELDS,
        "retired_statuses": sorted(RETIRED_STATUSES),
        "max_runtime_s": MAX_RUNTIME_S,
        "max_scan_points": MAX_SCAN_POINTS,
    }
    return _sha256(_canonical(policy).encode("utf-8")), policy


def _fingerprint(records, source_hash, policy_hash):
    selected = [
        {
            "id": row["id"],
            "payload_sha256": row["payload_sha256"],
            "payload_version": row["payload_version"],
        }
        for row in records
    ]
    selected.sort(key=lambda row: (row["id"], row["payload_sha256"]))
    material = {
        "schema": SCHEMA,
        "source_hash": source_hash,
        "policy_hash": policy_hash,
        "selected": selected,
    }
    return _sha256(_canonical(material).encode("utf-8"))


def _diagnostics(records):
    groups = {}
    retention = {"expired": 0, "active": 0, "unknown": 0}
    for row in records:
        retention[row["expiry"]] += 1
        if row["hash"] is None:
            continue
        groups.setdefault((row["scope_key"], row["hash"]), []).append(row)
    duplicate_groups = []
    for (scope_key, hash_value), members in sorted(groups.items(), key=lambda item: repr(item[0])):
        if len(members) < 2:
            continue
        duplicate_groups.append(
            {
                "scope_sha256": _scope_digest(scope_key),
                "hash": hash_value,
                "count": len(members),
                "provenance_ids": sorted(member["id"] for member in members),
            }
        )
    return {
        "active_points": len(records),
        "retention": retention,
        "hash_scope_duplicate_groups": len(duplicate_groups),
        "hash_scope_duplicate_excess": sum(group["count"] - 1 for group in duplicate_groups),
        "largest_hash_scope_group": max((group["count"] for group in duplicate_groups), default=0),
        "duplicate_candidates": duplicate_groups,
        "missing_hash_points": sum(1 for row in records if row["hash"] is None),
    }


def _signal_handlers():
    previous = {}

    def handle(signum, _frame):
        if signum == getattr(signal, "SIGALRM", object()):
            raise DeadlineExceeded("signal")
        raise RunInterrupted("signal")

    for name in ("SIGALRM", "SIGTERM", "SIGINT"):
        signum = getattr(signal, name, None)
        if signum is None:
            continue
        try:
            previous[signum] = signal.getsignal(signum)
            signal.signal(signum, handle)
        except (OSError, RuntimeError, ValueError):
            continue
    return previous


def _restore_signal_handlers(previous):
    for signum, handler in previous.items():
        try:
            signal.signal(signum, handler)
        except (OSError, RuntimeError, ValueError):
            pass


def _terminal_receipt(paths, value, *, dry_run):
    if dry_run:
        return False
    try:
        _atomic_json(paths["receipt"], value)
        return True
    except OSError:
        return False


def _base_result(paths, *, mode, max_seconds, max_points):
    return {
        "schema": SCHEMA,
        "complete": False,
        "overall": "FAIL",
        "scan_state": "FAILED",
        "mode": mode,
        "model_calls": 0,
        "store_writes": 0,
        "cache_written": False,
        "cache_status": "UNKNOWN",
        "input_state": "UNKNOWN",
        "fingerprint": None,
        "source_hash": _sha256_file(Path(__file__)),
        "policy_hash": _source_policy_hash()[0],
        "counts": {
            "pages": 0,
            "points_scanned": 0,
            "active_points": 0,
            "retention": {"expired": 0, "active": 0, "unknown": 0},
            "hash_scope_duplicate_groups": 0,
            "hash_scope_duplicate_excess": 0,
            "largest_hash_scope_group": 0,
            "missing_hash_points": 0,
        },
        "duplicate_candidates": [],
        "elapsed_s": 0.0,
        "reason": "not-run",
        "started_at": _now_mdt().isoformat(timespec="seconds"),
        "paths": {"receipt": str(paths["receipt"]), "cache": str(paths["cache"])},
        "limits": {"max_seconds": max_seconds, "max_points": max_points},
        "source_policy": {"metadata_fields": list(METADATA_FIELDS), "vectors": False, "text": False},
    }


def _retention_http(method, path, body, timeout_s):
    request = urllib.request.Request(
        _qdrant_url() + path, data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json"}, method=method,
    )
    with urllib.request.urlopen(request, timeout=timeout_s) as response:
        return json.load(response)


def _apply_reversible_retention(raw_points, diagnostics, paths, budget, today):
    retention = importlib.machinery.SourceFileLoader(
        "dream_retention", str(Path(__file__).resolve().parent / "retention.py")
    ).load_module()
    candidate_ids = set()
    for group in diagnostics["duplicate_candidates"]:
        candidate_ids.update(str(value) for value in group.get("provenance_ids", []))
    for point in raw_points:
        payload = point.get("payload") or {}
        if payload.get("retention_class") in {"noise", "unsupported", "transient", "ephemeral"}:
            candidate_ids.add(str(point["id"]))
    points = []
    ordered = sorted(candidate_ids)
    for start in range(0, len(ordered), 256):
        budget.check()
        response = _retention_http("POST", f"/collections/{_collection()}/points",
            {"ids": ordered[start:start + 256], "with_payload": True, "with_vector": False}, budget.timeout())
        page = response.get("result")
        if not isinstance(page, list):
            raise ValueError("malformed-retention-candidate-page")
        points.extend(page)
    plan = retention.plan_retention(points, as_of=today)
    maximum = _env_int("MEM0_DREAM_MAX_RETIREMENTS", 200, 1000)
    result = retention.apply_plan(
        _retention_http, _collection(), plan["entries"],
        paths["receipt"].parent / "retention-journal.jsonl",
        lock_path=paths["receipt"].parent / "retention.lock",
        max_mutations=maximum, max_seconds=max(0.01, budget.remaining()),
    )
    result.update(planned=len(plan["entries"]), plan_reasons=plan["reasons"], candidate_points=len(points),
                  source_changes=0, vector_changes=0, hard_deletes=0)
    return result


def run_maintenance(
    *,
    data_dir=None,
    lock_path=None,
    receipt_path=None,
    cache_path=None,
    log_path=None,
    dry_run=False,
    now=None,
    runtime_s=None,
    max_points=None,
    page_size=None,
    http_fn=None,
    apply_markers=False,
):
    """Run one bounded census and return its metadata-only terminal receipt."""

    paths = _path_config(data_dir, lock_path, receipt_path, cache_path, log_path)
    requested_runtime = runtime_s if runtime_s is not None else _env_float("MEM0_DREAM_MAX_SECONDS", MAX_RUNTIME_S, MAX_RUNTIME_S)
    requested_points = max_points if max_points is not None else _env_int("MEM0_DREAM_MAX_POINTS", MAX_SCAN_POINTS, MAX_SCAN_POINTS)
    requested_page = page_size if page_size is not None else _env_int("MEM0_DREAM_PAGE_SIZE", DEFAULT_PAGE_SIZE, MAX_SCAN_POINTS)
    max_seconds = min(MAX_RUNTIME_S, max(0.01, float(requested_runtime)))
    scan_limit = min(MAX_SCAN_POINTS, max(1, int(requested_points)))
    page_limit = min(scan_limit, max(1, int(requested_page)))
    started = time.monotonic()
    result = _base_result(
        paths,
        mode="DRY_RUN" if dry_run else "MAINTENANCE",
        max_seconds=max_seconds,
        max_points=scan_limit,
    )
    log_path_value = paths["log"]
    _log(
        f"DREAM-START mode={result['mode']} model_calls=0 store_writes=0 "
        f"max_seconds={max_seconds:g} max_points={scan_limit}",
        log_path_value,
    )
    if _dream_off(paths):
        result.update({"overall": "NOT_RUN", "scan_state": "NOT_RUN", "reason": "DREAM_OFF"})
        _log("DREAM-END overall=NOT_RUN model_calls=0 store_writes=0 reason=DREAM_OFF", log_path_value)
        return result

    try:
        lock_fd = _acquire_lock(paths["lock"])
    except OSError:
        result.update({"overall": "FAIL", "scan_state": "FAILED", "reason": "lock-error"})
        _terminal_receipt(paths, result, dry_run=dry_run)
        _log("DREAM-END overall=FAIL model_calls=0 store_writes=0 reason=lock-error", log_path_value)
        return result
    if lock_fd is None:
        result.update({"overall": "NOT_RUN", "scan_state": "NOT_RUN", "reason": "lock-held"})
        _log("DREAM-END overall=NOT_RUN model_calls=0 store_writes=0 reason=lock-held", log_path_value)
        return result

    previous_handlers = _signal_handlers()
    old_timer = None
    try:
        alarm = getattr(signal, "SIGALRM", None)
        if alarm is not None:
            try:
                old_timer = signal.setitimer(signal.ITIMER_REAL, max_seconds)
            except (OSError, RuntimeError, ValueError):
                old_timer = None
        cache, cache_status = _read_json(paths["cache"])
        result["cache_status"] = cache_status
        budget = _Budget(max_seconds)
        scan_now = (
            now.date()
            if isinstance(now, datetime)
            else now
            if isinstance(now, date)
            else datetime.now(timezone.utc).date()
        )
        fetch = http_fn or _http_json
        raw_points, pages, scan_state, scan_reason = _scroll_source(
            budget, scan_limit, page_limit, fetch
        )
        records = [_point_record(point, scan_now) for point in raw_points if _is_active(point)]
        records = [record for record in records if record is not None]
        diagnostics = _diagnostics(records)
        result["counts"] = {
            "pages": pages,
            "points_scanned": len(raw_points),
            **{key: value for key, value in diagnostics.items() if key != "duplicate_candidates"},
        }
        result["duplicate_candidates"] = diagnostics["duplicate_candidates"]
        result["scan_state"] = scan_state
        result["reason"] = scan_reason
        if scan_state != "COMPLETE":
            raise DeadlineExceeded(scan_reason)
        source_hash = result["source_hash"]
        policy_hash = result["policy_hash"]
        fingerprint = _fingerprint(records, source_hash, policy_hash)
        result["fingerprint"] = fingerprint
        if cache_status == "VALID" and cache.get("fingerprint") == fingerprint:
            result["input_state"] = "UNCHANGED"
        elif cache_status == "VALID":
            result["input_state"] = "CHANGED"
        elif cache_status == "MISSING":
            result["input_state"] = "INITIAL"
        else:
            result["input_state"] = "CHANGED"
        result["complete"] = True
        result["overall"] = "PASS"
        cache_value = {
            "schema": SCHEMA,
            "complete": True,
            "fingerprint": fingerprint,
            "source_hash": source_hash,
            "policy_hash": policy_hash,
            "counts": result["counts"],
        }
        if dry_run:
            result["reason"] = "dry-run"
        else:
            if apply_markers:
                result["source_policy"]["retention_candidates_full_payload"] = True
                result["retention_helper_sha256"] = _sha256_file(Path(__file__).resolve().parent / "retention.py")
                result["retention"] = _apply_reversible_retention(raw_points, diagnostics, paths, budget, scan_now)
                result["store_writes"] = result["retention"].get("mutations", 0)
                if result["retention"].get("state") not in {"PASS", "COMPLETE"}:
                    result["overall"] = result["retention"].get("state", "FAIL")
                    result["reason"] = "retention-" + str(result["retention"].get("reason", "incomplete"))
            result["elapsed_s"] = round(time.monotonic() - started, 6)
            _atomic_json(paths["cache"], cache_value)
            result["cache_written"] = True
            _atomic_json(paths["receipt"], result)
    except BaseException as exc:
        if isinstance(exc, (DeadlineExceeded, RunInterrupted)):
            result["scan_state"] = "PARTIAL"
            result["reason"] = "deadline" if isinstance(exc, DeadlineExceeded) else "interrupted"
        else:
            result["scan_state"] = "FAILED"
            result["reason"] = type(exc).__name__.lower()
        result["overall"] = "FAIL"
        result["complete"] = False
        result["elapsed_s"] = round(time.monotonic() - started, 6)
        _terminal_receipt(paths, result, dry_run=dry_run)
    finally:
        result["elapsed_s"] = round(time.monotonic() - started, 6)
        if old_timer is not None:
            try:
                signal.setitimer(signal.ITIMER_REAL, old_timer[0], old_timer[1])
            except (OSError, RuntimeError, ValueError):
                pass
        _restore_signal_handlers(previous_handlers)
        _release_lock(lock_fd)

    _log(
        "DREAM-END overall={overall} model_calls=0 store_writes={writes} pages={pages} "
        "points={points} active={active} duplicate_groups={groups} expired={expired} "
        "unknown_expiry={unknown} elapsed_s={elapsed:g} reason={reason}".format(
            overall=result["overall"],
            writes=result.get("store_writes", 0),
            pages=result["counts"].get("pages", 0),
            points=result["counts"].get("points_scanned", 0),
            active=result["counts"].get("active_points", 0),
            groups=result["counts"].get("hash_scope_duplicate_groups", 0),
            expired=result["counts"].get("retention", {}).get("expired", 0),
            unknown=result["counts"].get("retention", {}).get("unknown", 0),
            elapsed=result["elapsed_s"],
            reason=result["reason"],
        ),
        log_path_value,
    )
    return result


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="scan without changing receipt or cache")
    parser.add_argument("--proposal-only", action="store_true", help="compatibility flag; no proposals are emitted")
    parser.add_argument("--apply", action="store_true", help="removed: source mutation is not supported")
    parser.add_argument("--skip-seed", action="store_true")
    parser.add_argument("--skip-threads", action="store_true")
    parser.add_argument("--skip-email", action="store_true")
    parser.add_argument("--skip-consolidate", action="store_true")
    parser.add_argument("--with-luna", action="store_true")
    parser.add_argument("--max-clusters", type=int, default=None)
    args = parser.parse_args(argv)
    paths = _path_config()
    if args.apply:
        _log("DREAM-START mode=APPLY model_calls=0 store_writes=0", paths["log"])
        _log("DREAM-END overall=FAIL model_calls=0 store_writes=0 reason=apply-removed", paths["log"])
        return 1
    compatibility = [
        name
        for name in (
            "proposal-only",
            "skip-seed",
            "skip-threads",
            "skip-email",
            "skip-consolidate",
            "with-luna",
            "max-clusters",
        )
        if getattr(args, name.replace("-", "_"), None) not in (None, False)
    ]
    if compatibility:
        _log("DREAM-COMPAT ignored=" + ",".join(compatibility), paths["log"])
    result = run_maintenance(dry_run=args.dry_run, apply_markers=os.environ.get("MEM0_DREAM_RETENTION_ENABLED") == "1" and not args.proposal_only)
    return 0 if result["overall"] in {"PASS", "NOT_RUN"} else 1


if __name__ == "__main__":
    raise SystemExit(main())

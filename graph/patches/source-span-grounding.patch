+def _relative_document_path(text: str) -> bool:
+    """Recognize conservative relative tokens with a document-bearing segment.
+
+    No URL, escaping, traversal, empty segment or punctuation repair is inferred.
+    A slash alone is not evidence of a document identifier.
+    """
+    segment = r'[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*'
+    return (
+        '/' in text
+        and re.fullmatch(segment + r'(?:/' + segment + r')+', text) is not None
+        and any(re.fullmatch(
+            segment + r'[.](?:md|txt|pdf|json|ya?ml|csv|docx?|rst|py|js|ts|tsx|sha256)',
+            part, re.I,
+        ) for part in text.split('/'))
+    )
+

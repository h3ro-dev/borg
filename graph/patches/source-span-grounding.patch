+def _normalize_source_document_prefix(node: EntityNode, episode: EpisodicNode | None) -> None:
+    """Copy a unique complete source token, never a candidate's proposed name.
+
+    Already grounded names and the explicit-node interface retain their names.
+    Only a literal relative document prefix ending in a document extension is
+    eligible. Competing continuations (even unsupported ones) fail closed.
+    """
+    if episode is None or episode.group_id != node.group_id:
+        return
+    prefix = node.name
+    segment = r'[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*'
+    if re.fullmatch(
+        r'(?:' + segment + r'/)*' + segment
+        + r'[.](?:md|txt|pdf|json|ya?ml|csv|docx?|rst|py|js|ts|tsx|sha256)',
+        prefix, re.I,
+    ) is None:
+        return
+    try:
+        _exact_identifier_resolution(node, [], episode)
+        return
+    except ValueError:
+        pass  # The unchanged guard still rejects a direct partial-path match.
+    # Read maximal delimiter-bounded source tokens, not regex substrings of paths.
+    tokens = set(re.findall(r'''[^\s`"'<>()\[\]{},;]+''', episode.content))
+    continuations = {token for token in tokens if token.startswith(prefix + '/')}
+    if not continuations:
+        raise ValueError('exact_identifier_source_grounding_missing')
+    if len(continuations) != 1:
+        raise ValueError('exact_identifier_source_normalization_nonunique')
+    complete = next(iter(continuations))
+    if not _relative_document_path(complete):
+        raise ValueError('exact_identifier_source_normalization_unsupported_token')
+    probe = node.model_copy(update={'name': complete})
+    if _exact_identifier_key(complete) != ('document', complete):
+        raise ValueError('exact_identifier_source_normalization_not_document')
+    _exact_identifier_resolution(probe, [], episode)
+    # Preserve UUID, labels, summary and attributes; edge pointers keep identity.
+    node.name = complete
 
 

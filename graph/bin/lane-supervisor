#!/usr/bin/env python3
"""Crash/stall supervisor for configured graph pipeline lanes.

An external service manager supervises this CLI; the CLI does one pass and
writes an append-only JSONL receipt.

Pass order:
    kill switch -> ollama -> schema shim -> lanes -> crash scan

Safety invariants:
  * Kill ONLY by lockfile pid, -TERM then -KILL after 10s. NEVER pkill by
    pattern — a pattern kill took out our own monitors twice on 08-21.
  * Locks are authoritative. A live, matching lock pid means hands off.
  * STALLED  = lock pid alive but log or graph progress older than its bound.
  * DEAD     = lock missing / pid gone without the lane's stop condition met.
  * ollama is restarted only when /api/version itself fails — never because
    it is merely slow or busy.
  * Paid optional harvest lanes retain a hard pair cap and each relaunch asks
    only for the remaining balance.

Kill switch: create the file `KILL_SWITCH` beside this executable
(bin/KILL_SWITCH) and the supervisor stands down without touching anything.
"""
import argparse
import importlib.machinery
import json
import os
import re
import signal
import subprocess
import time
import urllib.error
import urllib.request
import uuid
from datetime import datetime, timezone
from pathlib import Path

BIN = Path(__file__).resolve().parent
CONFIG = importlib.machinery.SourceFileLoader(
    "borg_config_graph_supervisor", str(BIN / "borg_config.py")
).load_module().CONFIG
BASE = CONFIG.graph_root
DATA = BASE / "data"
VENV_PY = (CONFIG.mem0_root if CONFIG.portable else BASE) / "venv" / "bin" / "python"

RECEIPTS = DATA / "supervisor-receipts.jsonl"
SEEN_CRASHES = DATA / "supervisor-seen-crashes.json"
SELF_LOCK = DATA / "supervisor.lock"
KILL_SWITCH = BIN / "KILL_SWITCH"
CRASH_DIR = Path.home() / "Library" / "Logs" / "DiagnosticReports"

SCHEMA = "lane-supervisor/1"
ROTATE_BYTES = 8 * 1024 * 1024

# Restart governor: a crash-looping lane must not become a restart storm.
MIN_RESTART_GAP_S = 240
RESTART_BUDGET = 4
RESTART_WINDOW_S = 3600
DEP_COOLDOWN_S = {"schema-shim": 600, "ollama": 1800}

_graph_url = str(CONFIG.values["BORG_GRAPH_LLM_URL"]).rstrip("/")
SHIM_HEALTH = os.environ.get("SHIM_HEALTH", (_graph_url[:-3] if _graph_url.endswith("/v1") else _graph_url) + "/health")
SHIM_TIMEOUT_S = 5
OLLAMA_VERSION = str(CONFIG.values["BORG_OLLAMA_URL"]).rstrip("/") + "/api/version"
OLLAMA_TIMEOUT_S = 10
BREW = "/opt/homebrew/bin/brew"

LUNA_PAIR_CAP = 600
CRASH_WINDOW_S = 24 * 3600

# --- lane table -------------------------------------------------------------
